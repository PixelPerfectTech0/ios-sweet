+	kSetSecureMode = 0x66u,
+	kMaxClients = 16u,
+	kMethodSetPriority = 17u,     /* ABI v2 methods newer than this core's header (Turnip may send them) */
+	kMethodNote = 18u,
+	kWaitUs = 2000000u,
+};
+constexpr uint64_t kGmemBase = 0x1000000ull;    /* 16 MiB */
+constexpr uint64_t kTrapBase = 0x0001fffffffff000ull;
+constexpr uint64_t kClientWindow = 1ull << 32;   /* 4 GiB of GPU addresses per client */
+
+struct G7Gpu {
+	NativeAdrenoRing ring;
+	NativeAdrenoSubmit submit;
+	NativeAdrenoCpInit cpinit;
+	NativeAdrenoTimer timer;
+	NativeAdrenoStatus status;
+	NativeAdrenoAbiDeviceInfo info{};
+	NativeAdrenoRingIo io{};
+	NativeAdrenoRingCache cache{};
+	NativeAdrenoRingClock clock{};
+	NativeAdrenoTimeIo timeio{};
+	NativeAdrenoVm *vm = nullptr;
+	unsigned ias = 0, oas = 40;
+	IOLock *lock = nullptr;
+	uint32_t slots_used = 0;        /* bit n: client window n taken */
+	bool ready = false;
+};
+G7Gpu *gGpu;
+
+int
+rd32(void *, uint32_t reg, uint32_t *v)
+{
+	*v = g7_gpu_rd(reg);
+	return 0;
+}
+
+int
+wr32(void *, uint32_t reg, uint32_t v)
+{
+	g7_gpu_wr(reg, v);
+	return 0;
+}
+
+int
+barrier(void *)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+
+int
+publish(void *, const volatile uint32_t *words, size_t bytes)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	CleanPoC_DcacheRegion((vm_offset_t)words, bytes);
+	return 0;
+}
+
+int
+acquire(void *, volatile uint32_t *words, size_t bytes)
+{
+	FlushPoC_DcacheRegion((vm_offset_t)words, bytes);
+	return 0;
+}
+
+uint64_t
+now_us(void *)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000u;
+}
+
+int
+idle(void *)
+{
+	IODelay(20);
+	return 0;
+}
+
+void
+static char *gProgMsg;
+static size_t gProgLen;
+
+void
+progress(uint32_t step)
+{
+	IOLog("G7 GPU: stage8 GPU SMMU context step %u\n", step);
+	if (gProgMsg) {
+		snprintf(gProgMsg, gProgLen, "stage8: HUNG or still in: SMMU context step %u", step);
+	}
+}
+
+/*
+ * Free stream-match slots and an unused context bank of the GPU SMMU (ARM
+ * SMMU v2 global space): slots whose SMR valid bit is clear, a bank no valid
+ * S2CR translates to.
+ */
+bool
+pick_smmu(volatile uint8_t *s, unsigned slots[2], unsigned *bank)
+{
+	auto rd = [s](uint32_t off) { return *reinterpret_cast<volatile uint32_t *>(s + off); };
+	const unsigned nsmr = rd(0x20) & 0xffu, ncb = rd(0x24) & 0xffu;
+	uint32_t banks_used = 0;
+	unsigned found = 0;
+	for (unsigned i = 0; i < nsmr && i < 128; i++) {
+		const uint32_t smr = rd(0x800u + 4u * i), s2cr = rd(0xc00u + 4u * i);
+		if (smr & (1u << 31)) {
+			if (((s2cr >> 16) & 3u) == 0 && (s2cr & 0xffu) < 32u) {
+				banks_used |= 1u << (s2cr & 0xffu);
+			}
+		} else if (found < 2) {
+			slots[found++] = i;
+		}
+	}
+	for (unsigned b = 0; b < ncb && b < 32; b++) {
+		if (!(banks_used & (1u << b))) {
+			*bank = b;
+			return found == 2;
+		}
+	}
+	return false;
+}
+} /* namespace */
+
+/* ---- Metal accelerator service ---- */
+
+/* iOS's Metal discovery matches this class name (IOServiceMatching("IOAcceleratorES")). The user client is named
+ * AGXDeviceUserClient, the class Apple's sandbox profiles let graphics processes open. */
+class IOAcceleratorES : public IOService {
+	OSDeclareAbstractStructors(IOAcceleratorES)
+};
+OSDefineMetaClassAndAbstractStructors(IOAcceleratorES, IOService)
+
+class G7AdrenoAccelerator : public IOAcceleratorES {
+	OSDeclareDefaultStructors(G7AdrenoAccelerator)
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(G7AdrenoAccelerator, IOAcceleratorES)
+
+static G7AdrenoAccelerator *gAccelerator;
+
+class AGXDeviceUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AGXDeviceUserClient)
+	NativeAdrenoUserClient *core_ = nullptr;
+	task_t task_ = nullptr;
+	unsigned slot_ = 0;
+	bool open_ = false;
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool attachCore();
+	IOReturn clientClose() APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AGXDeviceUserClient, IOUserClient)
+
+bool
+G7AdrenoAccelerator::start(IOService *provider)
+{
+	if (!IOAcceleratorES::start(provider)) {
+		return false;
+	}
+	setProperty("MetalPluginName", "NativeAdrenoMetal");
+	setProperty("MetalPluginClassName", "NativeAdrenoMetalDevice");
+	setProperty("G7GPU", "Adreno 630");
+	gAccelerator = this;
+	/* registerService() waits for g7_adreno_bringup(): until the GPU runs, Metal finds no accelerator. */
+	return true;
+}
+
+IOReturn
+G7AdrenoAccelerator::newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *,
+    IOUserClient **handler)
+{
+	if (!gGpu || !gGpu->ready) {
+		return kIOReturnNotReady;
+	}
+	char who[24];
+	g7_stat_who(who, sizeof(who));
+	if (type != kOpenType && type != 0) {
+		if (gStatLogged < 400) {
+			gStatLogged++;
+			IOLog("G7 GPU: %s[%d] open type %#x (plugin marker)\n", who, proc_selfpid(), (unsigned)type);
+		}
+		return kIOReturnUnsupported;    /* the plugin's progress markers and anything else */
+	}
+	AGXDeviceUserClient *client = OSTypeAlloc(AGXDeviceUserClient);
+	if (!client || !client->initWithTask(owningTask, securityID, type) || !client->attach(this) ||
+	    !client->attachCore() || !client->start(this)) {
+		if (client) {
+			client->detach(this);
+			client->release();
+		}
+		IOLog("G7 GPU: %s[%d] open FAILED (no client slot)\n", who, proc_selfpid());
+		return kIOReturnNoResources;
+	}
+	uint32_t opens = ++gStatOpens;
+	if (gStatLogged < 400) {
+		gStatLogged++;
+		IOLog("G7 GPU: %s[%d] opened the GPU (client %u)\n", who, proc_selfpid(), opens);
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+bool
+AGXDeviceUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	task_ = owningTask;
+	return true;
+}
+
+/* One NativeAdreno client on the shared VM, ring and submit object, in its own 4 GiB GPU window and queue range. */
+bool
+AGXDeviceUserClient::attachCore()
+{
+	IOLockLock(gGpu->lock);
+	const uint64_t span = (gGpu->ias >= 33 ? (1ull << gGpu->ias) : 0) - GpuClientVaStart;
+	unsigned windows = (unsigned)(span / kClientWindow);
+	if (windows > kMaxClients) {
+		windows = kMaxClients;
+	}
+	unsigned slot = 0;
+	while (slot < windows && (gGpu->slots_used & (1u << slot))) {
+		slot++;
+	}
+	bool ok = slot < windows;
+	if (ok) {
+		core_ = new NativeAdrenoUserClient;
+		ok = core_ &&
+		    core_->open(NativeAdrenoAbiVersion, gGpu->vm, &gGpu->submit, &gGpu->ring, gGpu->ias, gGpu->oas) == kIOReturnSuccess &&
+		    core_->setScope((uint64_t)slot * NativeAdrenoQueueRange, GpuClientVaStart + slot * kClientWindow,
+		    kClientWindow) == kIOReturnSuccess;
+	}
+	if (ok) {
+		/* GetDeviceInfo reports this client's window as its VA range (NativeAdrenoUserClient::deviceInfo). */
+		(void)core_->attachTimer(&gGpu->timer);
+		(void)core_->attachStatus(&gGpu->status);
+		(void)core_->attachDeviceInfo(&gGpu->info);
+		core_->setStatsSlot(slot < 4 ? slot : 4);
+		gGpu->slots_used |= 1u << slot;
+		slot_ = slot;
+		open_ = true;
+	} else if (core_) {
+		delete core_;
+		core_ = nullptr;
+	}
+	IOLockUnlock(gGpu->lock);
+	return ok;
+}
+
+IOReturn
+AGXDeviceUserClient::clientClose()
+{
+	if (open_) {
+		IOLockLock(gGpu->lock);
+		(void)core_->releaseAll(&gGpu->clock, kWaitUs);
+		(void)core_->close();
+		gGpu->slots_used &= ~(1u << slot_);
+		open_ = false;
+		IOLockUnlock(gGpu->lock);
+	}
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+AGXDeviceUserClient::free()
+{
+	if (core_ && !open_) {
+		delete core_;       /* an open core (never closed) is kept: its BOs may still be in GPU use */
+		core_ = nullptr;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+AGXDeviceUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *, OSObject *, void *)
+{
+	if (!open_ || !args) {
+		return kIOReturnNotOpen;
+	}
+	const uint8_t *in = static_cast<const uint8_t *>(args->structureInput);
+	size_t in_size = args->structureInputSize;
+	uint32_t method = selector;
+	if (in && in_size >= 8 && *reinterpret_cast<const uint32_t *>(in) == kTunnelMagic) {
+		method = reinterpret_cast<const uint32_t *>(in)[1];
+		if (method == kTunnelProbe) {
+			return kIOReturnSuccess;
+		}
+		in += 8;
+		in_size -= 8;
+	}
+	void *out = args->structureOutput;
+	size_t out_size = args->structureOutputSize;
+	IOReturn r;
+	IOLockLock(gGpu->lock);
+	if (method == NativeAdrenoMethodBoImport) {
+		if (in_size != sizeof(NativeAdrenoAbiBoImport) || out_size != sizeof(NativeAdrenoAbiBoAllocReply)) {
+			r = kIOReturnBadArgument;
+		} else {
+			r = core_->importBo(reinterpret_cast<const NativeAdrenoAbiBoImport *>(in), task_,
+			    static_cast<NativeAdrenoAbiBoAllocReply *>(out));
+		}
+	} else if (method == kMethodSetPriority || method == kMethodNote) {
+		r = kIOReturnSuccess;   /* one ring, no priorities; notes are not kept */
+	} else {
+		r = core_->dispatch(method, in, in_size, out, out_size, &gGpu->clock);
+	}
+	IOLockUnlock(gGpu->lock);
+	if (method < 20) {
+		gStatCalls[method]++;
+	}
+	if (r != kIOReturnSuccess) {
+		uint32_t e = ++gStatErrors;
+		if (e <= 40 && gStatLogged < 400) {
+			char who[24];
+			gStatLogged++;
+			g7_stat_who(who, sizeof(who));
+			IOLog("G7 GPU: %s method %u FAILED %#x (in %zu out %zu)\n", who, method, r, in_size, out_size);
+		}
+	}
+	if (method == NativeAdrenoMethodSubmit && r == kIOReturnSuccess) {
+		uint32_t s = ++gStatSubmits;
+		if (s == 1 || s == 16 || (s % 256) == 0) {
+			IOLog("G7 GPU: %u submits, %u opens, %u errors, allocs %u imports %u waits %u\n", s, gStatOpens,
+			    gStatErrors, gStatCalls[NativeAdrenoMethodBoAlloc], gStatCalls[NativeAdrenoMethodBoImport],
+			    gStatCalls[NativeAdrenoMethodWaitFence]);
+		}
+	}
+	if (r == kIOReturnSuccess && out) {
+		args->structureOutputSize = (uint32_t)out_size;
+	}
+	return r;
+}
+
+IOReturn
+AGXDeviceUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	if (!open_) {
+		return kIOReturnNotOpen;
+	}
+	IOLockLock(gGpu->lock);
+	NativeAdrenoMemory *m = core_->memoryForToken(type);
+	IOBufferMemoryDescriptor *d = m ? m->descriptor() : nullptr;
+	if (d) {
+		d->retain();
+		*memory = d;
+		*options = m->writeCombined() ? kIOMapWriteCombineCache : 0;
+	}
+	IOLockUnlock(gGpu->lock);
+	return d ? kIOReturnSuccess : kIOReturnBadArgument;
+}
+
+/* ---- bring-up, called by bsd/dev/g7_gpu.c with g7gpu=8 ---- */
+
+int
+g7_adreno_bringup(char *msg, size_t n)
+{
+#define G7_FAIL(...) do { snprintf(msg, n, __VA_ARGS__); return -1; } while (0)
+	if (gGpu) {
+		G7_FAIL("stage8: already brought up");
+	}
+	gProgMsg = msg;
+	gProgLen = n;
+	snprintf(msg, n, "stage8: HUNG or still in: SMMU map");
+	vm_offset_t smmu = g7_gpu_smmu();
+	if (!smmu) {
+		G7_FAIL("stage8: GPU SMMU map failed");
+	}
+	unsigned slots[2] = {}, bank = 0;
+	if (!pick_smmu(reinterpret_cast<volatile uint8_t *>(smmu), slots, &bank)) {
+		G7_FAIL("stage8: no free GPU SMMU stream slots or context bank");
+	}
+	/* sdm845.dtsi: the GPU is iommus = <&adreno_smmu 0>; stream 1 is its second (secure/LPAC) id. */
+	const unsigned sids[2] = {0x0, 0x1};
+	NativeAdrenoGmuContextReport report{};
+	IOReturn r = NativeAdrenoGpuContextBringupRoutes(reinterpret_cast<volatile uint8_t *>(smmu), 0x10000, bank, 1,
+	    slots, sids, 2, progress, &report);
+	IOLog("G7 GPU: stage8 SMMU bank %u slots %u/%u: %#x step %u program %u route %u ias %u oas %u\n", bank,
+	    slots[0], slots[1], r, report.step, report.program_status, report.route_status,
+	    NativeAdrenoGpuContextInputBits(), report.output_bits);
+	if (r) {
+		G7_FAIL("stage8: GPU SMMU context failed at step %u (%#x, program %u, route %u)", report.step, r,
+		    report.program_status, report.route_status);
+	}
+	gProgMsg = nullptr;
+	snprintf(msg, n, "stage8: HUNG or still in: context buffers");
+	NativeAdrenoGpuContext *ctx = NativeAdrenoGpuContextObject();
+	NativeAdrenoGpuBuffer buf[GpuBufferCount] = {};
+	if (!ctx || NativeAdrenoGpuContextBuffers(buf)) {
+		G7_FAIL("stage8: GPU context has no buffers");
+	}
+
+	G7Gpu *g = new G7Gpu;
+	if (!g || !(g->lock = IOLockAlloc())) {
+		G7_FAIL("stage8: out of memory");
+	}
+	g->ias = NativeAdrenoGpuContextInputBits();
+	g->oas = report.output_bits ? report.output_bits : 40;
+	g->vm = ctx->vm();
+	g->io = {nullptr, wr32, rd32, barrier, nullptr, nullptr};
+	g->cache = {nullptr, publish, acquire};
+	g->clock = {nullptr, now_us, idle};
+	g->timeio = {nullptr, rd32};
+
+	snprintf(msg, n, "stage8: HUNG or still in: SQE copy");
+	/* SQE microcode into its buffer (index 0). */
+	uint32_t words = 0;
+	const uint32_t *fw = g7_gpu_sqe(&words);
+	const NativeAdrenoMemory &sqe = ctx->buffer(0);
+	volatile uint32_t *sq = static_cast<volatile uint32_t *>(sqe.mapping());
+	if (!sq || words * 4u > sqe.bytes()) {
+		G7_FAIL("stage8: SQE buffer %p too small (%zu < %u)", (void *)sq, sqe.bytes(), words * 4u);
+	}
+	for (uint32_t i = 0; i < words; i++) {
+		sq[i] = fw[i];
+	}
+	publish(nullptr, sq, words * 4u);
+
+	/* Registers, ring, SQE start, CP_ME_INIT. */
+	snprintf(msg, n, "stage8: HUNG or still in: GPU_SET hold / register setup");
+	if (g7_gpu_prepare(kGmemBase)) {
+		G7_FAIL("stage8: GMU did not hold the GPU on (GPU_SET)");
+	}
+	snprintf(msg, n, "stage8: HUNG or still in: ring attach");
+	const NativeAdrenoMemory &ringm = ctx->buffer(1), &memptrs = ctx->buffer(2);
+	if ((r = g->ring.setGeneration(6)) ||
+	    (r = g->ring.attach(&g->io, &g->cache, ringm.mapping(), ringm.bytes(), buf[1].iova,
+	    memptrs.mapping(), memptrs.bytes(), buf[2].iova))) {
+		G7_FAIL("stage8: ring attach failed (%#x)", r);
+	}
+	g7_gpu_wr(kCpSqeInstrBase, (uint32_t)buf[0].iova);
+	g7_gpu_wr(kCpSqeInstrBase + 1, (uint32_t)(buf[0].iova >> 32));
+	g7_gpu_wr(kCpSqeCntl, 1);
+	snprintf(msg, n, "stage8: HUNG or still in: CP_ME_INIT");
+	NativeAdrenoCpInitConfig cfg{buf[0].iova, 0, 1, 6};
+	uint32_t fence = 0, seen = 0;
+	if ((r = g->cpinit.run(&g->io, &g->ring, &cfg, &fence))) {
+		G7_FAIL("stage8: CP_ME_INIT submission failed (%#x)", r);
+	}
+	NativeAdrenoRingFence f = g->ring.wait(fence, &g->clock, kWaitUs, &seen);
+	if (f != NativeAdrenoRingFenceComplete) {
+		uint32_t st[NativeAdrenoRingStallWords] = {};
+		(void)g->ring.stallState(st);
+		G7_FAIL("stage8: CP did not finish ME_INIT through the SMMU (fence %u seen %u, state %u, rptr %#x wptr %#x)",
+		    fence, seen, (unsigned)f, st[0], st[1]);
+	}
+
+	/* Zap shader, then leave secure mode. */
+	snprintf(msg, n, "stage8: HUNG or still in: zap shader");
+	if (g7_gpu_zap()) {
+		G7_FAIL("stage8: CP runs through the SMMU, but the zap shader was refused");
+	}
+	uint32_t secure[2];
+	if (AdrenoPM4Type7(kSetSecureMode, 1, &secure[0]) != AdrenoPM4Success) {
+		G7_FAIL("stage8: packet encoding failed");
+	}
+	secure[1] = 0;
+	if ((r = g->ring.submit(secure, 2, &fence)) ||
+	    g->ring.wait(fence, &g->clock, kWaitUs, &seen) != NativeAdrenoRingFenceComplete) {
+		G7_FAIL("stage8: zap loaded, but CP_SET_SECURE_MODE did not complete (%#x, fence %u seen %u)", r, fence, seen);
+	}
+
+	/* Submissions, timer, device facts, then publish. */
+	snprintf(msg, n, "stage8: HUNG or still in: submit attach");
+	if ((r = g->submit.attach(g->vm, &g->ring))) {
+		G7_FAIL("stage8: submit attach failed (%#x)", r);
+	}
+	(void)g->timer.attach(&g->timeio, NativeAdrenoTimeCp);
+	g->info.chip_id = kChipId;
+	g->info.gmem_bytes = kGmemBytes;
+	g->info.gmem_base = kGmemBase;
+	g->info.uche_trap_base = kTrapBase;
+	g->info.va_start = GpuClientVaStart;
+	g->info.va_size = kClientWindow;
+	g->info.highest_bank_bit = 15;      /* SDM845 LPDDR4X, Linux a6xx_calc_ubwc_config for A630 */
+	g->info.ubwc_swizzle = 0x6;
+	g->info.macrotile_mode = 0;
+	g->info.ubwc_version = 2;           /* UBWC 2.0 on A630 */
+	g->info.flags = NativeAdrenoDeviceClientIova;
+	g->ready = true;
+	gGpu = g;
+	if (gAccelerator) {
+		gAccelerator->registerService();
+	}
+	snprintf(msg, n, "stage8: GPU READY for Metal: SMMU bank %u, ias %u, CP and zap ok, accelerator %s",
+	    bank, g->ias, gAccelerator ? "published" : "MISSING (no IOResources match)");
+	return 0;
+#undef G7_FAIL
+}
