+    IrqRbbmStatus = 0x0201,
+    IrqRbbmClear = 0x0037,
+    IrqRbbmMask = 0x0038,
+    IrqCpStatus = 0x0823,
+    IrqCpProtect = 0x0824,
+    IrqBitIdle = 1u << 0,
+    IrqBitAhb = 1u << 1,
+    IrqBitAtbAsync = 1u << 6,
+    IrqBitGpc = 1u << 7,
+    IrqBitCpSw = 1u << 8,
+    IrqBitCpHw = 1u << 9,
+    IrqBitCpCcuDepth = 1u << 10,
+    IrqBitCpCcuColor = 1u << 11,
+    IrqBitCpCcuResolve = 1u << 12,
+    IrqBitCpIb2 = 1u << 13,
+    IrqBitCpIb1 = 1u << 14,
+    IrqBitCpPm4 = 1u << 15,
+    IrqBitCpPm4Lpac = 1u << 16,
+    IrqBitCpRbDone = 1u << 17,
+    IrqBitCpWtDone = 1u << 18,
+    IrqBitCpFence = 1u << 20,
+    IrqBitCpFenceLpac = 1u << 21,
+    IrqBitAtbBus = 1u << 22,
+    IrqBitHang = 1u << 23,
+    IrqBitUcheOob = 1u << 24,
+    IrqBitUcheTrap = 1u << 25,
+    IrqBitTsbWrite = 1u << 28,
+    IrqBitFuse = 1u << 29,
+    IrqBitIsdbCpu = 1u << 30,
+    IrqBitIsdbDebug = 1u << 31
+};
+/* Every A7XX status bit that this decoder knows and may clear. */
+static constexpr uint32_t kKnown = IrqBitIdle | IrqBitAhb | IrqBitAtbAsync | IrqBitGpc |
+    IrqBitCpSw | IrqBitCpHw | IrqBitCpCcuDepth | IrqBitCpCcuColor | IrqBitCpCcuResolve |
+    IrqBitCpIb1 | IrqBitCpIb2 | IrqBitCpPm4 | IrqBitCpPm4Lpac | IrqBitCpRbDone |
+    IrqBitCpWtDone | IrqBitCpFence | IrqBitCpFenceLpac | IrqBitAtbBus | IrqBitHang |
+    IrqBitUcheOob | IrqBitUcheTrap | IrqBitTsbWrite | IrqBitFuse | IrqBitIsdbCpu |
+    IrqBitIsdbDebug;
+/* A7XX_INT_MASK from the pinned a6xx_gpu.c. */
+static constexpr uint32_t kEnable = IrqBitAhb | IrqBitAtbAsync | IrqBitGpc | IrqBitCpSw |
+    IrqBitCpHw | IrqBitCpPm4 | IrqBitCpRbDone | IrqBitCpFence | IrqBitAtbBus |
+    IrqBitHang | IrqBitUcheOob | IrqBitUcheTrap | IrqBitTsbWrite | IrqBitFuse;
+/* A6XX_INT_MASK, from a6xx_gpu.c's definition of the same name, whose eleven terms are
+ * A6XX_RBBM_INT_0_MASK_CP_AHB_ERROR (0x2), _RBBM_ATB_ASYNCFIFO_OVERFLOW (0x40),
+ * _CP_HW_ERROR (0x200), _CP_IB2 (0x2000), _CP_IB1 (0x4000), _CP_RB (0x8000),
+ * _CP_CACHE_FLUSH_TS (0x100000), _RBBM_ATB_BUS_OVERFLOW (0x400000),
+ * _RBBM_HANG_DETECT (0x800000), _UCHE_OOB_ACCESS (0x1000000) and _UCHE_TRAP_INTR
+ * (0x2000000) in a6xx.xml.h. Their sum is 0x03d0e242, which the host test pins.
+ * CP_RB (A6xx) is the bit A7XX names CP_PM4: same position, and Linux enables it
+ * on both cores. */
+static constexpr uint32_t kEnableA6xx = IrqBitAhb | IrqBitAtbAsync | IrqBitCpHw | IrqBitCpIb2 |
+    IrqBitCpIb1 | IrqBitCpPm4 | IrqBitCpFence | IrqBitAtbBus | IrqBitHang | IrqBitUcheOob |
+    IrqBitUcheTrap;
+/* CP_INTERRUPT_STATUS error bits, including the A7XX LPAC/BV replicas. */
+static constexpr uint32_t kCpErrors = 0x3fff7u;
