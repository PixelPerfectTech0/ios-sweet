--- /dev/null
+++ b/bsd/dev/g7_gpu.c
@@ -0,0 +1,261 @@
+/*
+ * LG G7 ThinQ (SDM845): Adreno 630 bring-up, written for this port.
+ *
+ * Stage 1 (boot-arg g7gpu=1): read-only. Reports what the bootloader left
+ * powered and clocked for the GPU: the GCC branches that feed it and the
+ * GPU clock controller's (GPUCC) GMU clocks and CX/GX power domains.
+ * Nothing is written, and GPUCC is only read when its AHB clock is on (a
+ * read of an unclocked block can hang the bus).
+ * Stage 2 (g7gpu=2): turns on the GPU's bus clocks, the CX power domain and
+ * the GMU clocks (from the crystal), then checks that the GMU answers.
+ * (On the G7 the bootloader leaves all of it off; stage 1 found the AHB
+ * clock on and everything else off.)
+ *
+ * Offsets: Linux drivers/clk/qcom/gcc-sdm845.c and gpucc-sdm845.c
+ * (register facts only). Bit layout: a branch control register (CBCR) has
+ * CLK_OFF in bit 31; a GDSC control register has PWR_ON in bit 31.
+ * Output lines start with "G7 GPU:" and repeat for a while after boot so
+ * they can be read on the panel.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void g7_gpu_init(void);
+
+#define G7G_GCC_PA          0x00100000u
+#define G7G_GCC_SIZE        0x00080000u
+#define G7G_GCC_GPU_CFG_AHB 0x71004u    /* gcc_gpu_cfg_ahb_clk: GPUCC register access */
+#define G7G_GCC_GPU_MEMNOC  0x7100cu    /* gcc_gpu_memnoc_gfx_clk */
+#define G7G_GCC_GPU_SNOC    0x71018u    /* gcc_gpu_snoc_dvm_gfx_clk */
+#define G7G_GCC_VOTE        0x52004u    /* bits 15/16: gpll0 / gpll0_div to the GPU */
+
+#define G7G_GPUCC_PA        0x05090000u
+#define G7G_GPUCC_SIZE      0x00002000u
+#define G7G_CX_GDSCR        0x106cu
+#define G7G_GX_GDSCR        0x100cu
+#define G7G_CX_GMU_CBCR     0x1098u
+#define G7G_CXO_CBCR        0x109cu
+#define G7G_GMU_RCG         0x1120u
+#define G7G_CX_GDS_HW_CTRL  0x1540u
+
+#define G7G_OFF             (1u << 31)
+
+/* GMU window: registers are dword offsets from the GPU base 0x05000000. */
+#define G7G_GPU_PA          0x05000000u
+#define G7G_GMU_PA          0x0506a000u
+#define G7G_GMU_SIZE        0x00030000u
+#define G7G_GMU_CM3_SYSRESET        0x1f800u
+#define G7G_GMU_CM3_FW_INIT_RESULT  0x1f81cu
+#define G7G_GMU_AO_COUNTER_L        0x1f888u
+#define G7G_GMU_SPTPRAC_STATUS      0x1f8d0u
+
+static int g7g_chan;
+static struct {
+	vm_offset_t gcc, gpucc, gmu;
+	unsigned level;
+	char summary[160];
+} g7g;
+
+static uint32_t
+g7g_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+g7g_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static uint32_t
+g7g_gmu_rd(uint32_t dword)
+{
+	return g7g_rd(g7g.gmu, dword * 4u - (G7G_GMU_PA - G7G_GPU_PA));
+}
+
+static void
+g7g_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&g7g_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static const char *
+g7g_on(uint32_t cbcr)
+{
+	return (cbcr & G7G_OFF) ? "off" : "on";
+}
+
+/* Turn one GCC/GPUCC branch on (CLK_ENABLE) and wait for CLK_OFF to clear. */
+static bool
+g7g_branch_on(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = g7g_rd(base, off);
+	if (!(v & G7G_OFF)) {
+		return true;
+	}
+	g7g_wr(base, off, v | 1u);
+	for (int i = 0; i < 500; i++) {
+		if (!(g7g_rd(base, off) & G7G_OFF)) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+/*
+ * Stage 2: the GPU's bus clocks, the CX power domain and the GMU clocks
+ * (GMU core clock from the 19.2 MHz crystal: slow but needs no PLL), then
+ * read-only checks that the GMU block answers. The GMU's always-on counter
+ * runs from the crystal, so two reads that differ prove the block is alive.
+ */
+static void
+g7g_stage2(void)
+{
+	bool memnoc = g7g_branch_on(g7g.gcc, G7G_GCC_GPU_MEMNOC);
+	bool snoc = g7g_branch_on(g7g.gcc, G7G_GCC_GPU_SNOC);
+	g7g_wr(g7g.gcc, G7G_GCC_VOTE, g7g_rd(g7g.gcc, G7G_GCC_VOTE) | (1u << 15) | (1u << 16));
+	printf("G7 GPU: stage2 memnoc %s snoc_dvm %s gpll0 vote %#x\n", memnoc ? "on" : "FAILED",
+	    snoc ? "on" : "FAILED", g7g_rd(g7g.gcc, G7G_GCC_VOTE));
+
+	/* CX GDSC (votable: status in GDS_HW_CTRL bit 31): clear SW_COLLAPSE. */
+	uint32_t cx = g7g_rd(g7g.gpucc, G7G_CX_GDSCR);
+	g7g_wr(g7g.gpucc, G7G_CX_GDSCR, cx & ~1u);
+	int us = 0;
+	while (us < 20000 && !(g7g_rd(g7g.gpucc, G7G_CX_GDS_HW_CTRL) & (1u << 31)) &&
+	    !(g7g_rd(g7g.gpucc, G7G_CX_GDSCR) & (1u << 31))) {
+		delay(10);
+		us += 10;
+	}
+	cx = g7g_rd(g7g.gpucc, G7G_CX_GDSCR);
+	uint32_t hw = g7g_rd(g7g.gpucc, G7G_CX_GDS_HW_CTRL);
+	bool cx_on = ((cx | hw) & (1u << 31)) != 0;
+	printf("G7 GPU: stage2 CX gdsc %#x hwctl %#x after %d us -> %s\n", cx, hw, us, cx_on ? "ON" : "off");
+	if (!cx_on) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage2: CX power domain would not turn on");
+		return;
+	}
+
+	/* GMU clock source: crystal (source 0), no divider; then latch it. */
+	g7g_wr(g7g.gpucc, G7G_GMU_RCG + 4u, 0);
+	g7g_wr(g7g.gpucc, G7G_GMU_RCG, g7g_rd(g7g.gpucc, G7G_GMU_RCG) | 1u);
+	for (int i = 0; i < 500 && (g7g_rd(g7g.gpucc, G7G_GMU_RCG) & 1u); i++) {
+		delay(10);
+	}
+	bool cxo = g7g_branch_on(g7g.gpucc, G7G_CXO_CBCR);
+	bool gmuclk = g7g_branch_on(g7g.gpucc, G7G_CX_GMU_CBCR);
+	printf("G7 GPU: stage2 gmu_rcg %#x/%#x cxo %s cx_gmu %s\n", g7g_rd(g7g.gpucc, G7G_GMU_RCG),
+	    g7g_rd(g7g.gpucc, G7G_GMU_RCG + 4u), cxo ? "on" : "FAILED", gmuclk ? "on" : "FAILED");
+	if (!cxo || !gmuclk) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage2: CX on, but GMU clocks would not start");
+		return;
+	}
+
+	/* GMU registers: GPU base + dword offset * 4 (Mesa a6xx_gmu.xml). */
+	g7g.gmu = ml_io_map(G7G_GMU_PA, G7G_GMU_SIZE);
+	if (!g7g.gmu) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage2: GMU map failed");
+		return;
+	}
+	uint32_t ao1 = g7g_gmu_rd(G7G_GMU_AO_COUNTER_L);
+	delay(1000);
+	uint32_t ao2 = g7g_gmu_rd(G7G_GMU_AO_COUNTER_L);
+	uint32_t init = g7g_gmu_rd(G7G_GMU_CM3_FW_INIT_RESULT);
+	uint32_t rst = g7g_gmu_rd(G7G_GMU_CM3_SYSRESET);
+	uint32_t sptp = g7g_gmu_rd(G7G_GMU_SPTPRAC_STATUS);
+	printf("G7 GPU: stage2 GMU always-on %#x -> %#x, cm3 sysreset %#x fw_init %#x sptprac %#x\n",
+	    ao1, ao2, rst, init, sptp);
+	snprintf(g7g.summary, sizeof(g7g.summary),
+	    "stage2: CX on, GMU clocks on, GMU %s (counter %#x -> %#x), CM3 reset %#x",
+	    ao1 != ao2 ? "ALIVE" : "not counting", ao1, ao2, rst);
+}
+
+static void
+g7g_probe(void)
+{
+	uint32_t ahb = g7g_rd(g7g.gcc, G7G_GCC_GPU_CFG_AHB);
+	uint32_t memnoc = g7g_rd(g7g.gcc, G7G_GCC_GPU_MEMNOC);
+	uint32_t snoc = g7g_rd(g7g.gcc, G7G_GCC_GPU_SNOC);
+	uint32_t vote = g7g_rd(g7g.gcc, G7G_GCC_VOTE);
+
+	printf("G7 GPU: gcc cfg_ahb %#x (%s) memnoc %#x (%s) snoc_dvm %#x (%s) gpll0 vote %u/%u\n",
+	    ahb, g7g_on(ahb), memnoc, g7g_on(memnoc), snoc, g7g_on(snoc),
+	    (vote >> 15) & 1u, (vote >> 16) & 1u);
+	if ((ahb & G7G_OFF) && g7g.level >= 2) {
+		g7g_wr(g7g.gcc, G7G_GCC_GPU_CFG_AHB, ahb | 1u);
+		for (int i = 0; i < 200 && (g7g_rd(g7g.gcc, G7G_GCC_GPU_CFG_AHB) & G7G_OFF); i++) {
+			delay(10);
+		}
+		ahb = g7g_rd(g7g.gcc, G7G_GCC_GPU_CFG_AHB);
+		printf("G7 GPU: cfg_ahb enabled -> %#x (%s)\n", ahb, g7g_on(ahb));
+	}
+	if (ahb & G7G_OFF) {
+		snprintf(g7g.summary, sizeof(g7g.summary),
+		    "stage1: GPU AHB clock off (bootloader left GPU unclocked); g7gpu=2 turns it on");
+		return;
+	}
+	g7g.gpucc = ml_io_map(G7G_GPUCC_PA, G7G_GPUCC_SIZE);
+	if (!g7g.gpucc) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage1: GPUCC map failed");
+		return;
+	}
+	uint32_t cx = g7g_rd(g7g.gpucc, G7G_CX_GDSCR), gx = g7g_rd(g7g.gpucc, G7G_GX_GDSCR);
+	uint32_t gmu = g7g_rd(g7g.gpucc, G7G_CX_GMU_CBCR), cxo = g7g_rd(g7g.gpucc, G7G_CXO_CBCR);
+	uint32_t rcg = g7g_rd(g7g.gpucc, G7G_GMU_RCG), rcgcfg = g7g_rd(g7g.gpucc, G7G_GMU_RCG + 4u);
+	printf("G7 GPU: gpucc CX gdsc %#x GX gdsc %#x cx_gmu %#x cxo %#x gmu_rcg %#x/%#x hwctl %#x\n",
+	    cx, gx, gmu, cxo, rcg, rcgcfg, g7g_rd(g7g.gpucc, G7G_CX_GDS_HW_CTRL));
+	snprintf(g7g.summary, sizeof(g7g.summary),
+	    "stage1: CX power %s, GX power %s, GMU clock %s, CXO clock %s",
+	    (cx & G7G_OFF) ? "ON" : "off", (gx & G7G_OFF) ? "ON" : "off",
+	    g7g_on(gmu), g7g_on(cxo));
+	if (g7g.level >= 2) {
+		g7g_stage2();
+	}
+}
+
+static void
+g7g_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	g7g_sleep(25000);       /* after the boot scroll */
+	g7g.gcc = ml_io_map(G7G_GCC_PA, G7G_GCC_SIZE);
+	if (!g7g.gcc) {
+		printf("G7 GPU: GCC map failed\n");
+	} else {
+		g7g_probe();
+	}
+	for (int i = 0; i < 60; i++) {
+		printf("G7 GPU: %s\n", g7g.summary[0] ? g7g.summary : "no result");
+		g7g_sleep(10000);
+	}
+	(void)thread_terminate(current_thread());
+}
+
+void
+g7_gpu_init(void)
+{
+	thread_t t;
+	(void)PE_parse_boot_argn("g7gpu", &g7g.level, sizeof(g7g.level));
+	if (g7g.level == 0) {
+		return;
+	}
+	if (kernel_thread_start(g7g_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- /dev/null
+++ b/bsd/dev/g7_perf.c
@@ -0,0 +1,114 @@
+/*
+ * LG G7 ThinQ (SDM845): CPU clock speed, written for this port.
+ *
+ * Nothing in this kernel sets the CPU frequency, so both clusters stay at
+ * whatever performance level the bootloader left. SDM845's CPU frequency
+ * hardware (OSM) takes a level index per cluster: each cluster has a table
+ * of levels (frequency = L_VAL * 19.2 MHz) and a register that selects one.
+ * The firmware's limits management (LMh) still caps the clock for heat.
+ *
+ * Boot-arg g7perf=N (default 85): run each cluster at the highest table
+ * level at or below N % of its top normal level; g7perf=0 leaves them alone.
+ * Register layout: Linux drivers/cpufreq/qcom-cpufreq-hw.c (qcom_soc_data):
+ * enable 0x0, frequency table 0x110 (32-byte rows), current vote 0x704,
+ * performance state 0x920. Lines start with "G7 PERF:".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void g7_perf_init(void);
+
+#define G7P_ENABLE      0x000u
+#define G7P_LUT         0x110u
+#define G7P_ROW         32u
+#define G7P_ROWS        40u
+#define G7P_VOTE        0x704u
+#define G7P_STATE       0x920u
+#define G7P_XO_KHZ      19200u
+
+static const struct {
+	const char *name;
+	uint32_t pa;
+} g7p_domains[] = {
+	{ "little (A55)", 0x17d43000u },
+	{ "big (A75)", 0x17d45800u },
+};
+
+static uint32_t
+g7p_rd(vm_offset_t b, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(b + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+g7p_domain(const char *name, uint32_t pa, unsigned pct)
+{
+	vm_offset_t b = ml_io_map(pa, 0x1000);
+	if (!b) {
+		printf("G7 PERF: %s map failed\n", name);
+		return;
+	}
+	if (!(g7p_rd(b, G7P_ENABLE) & 1u)) {
+		printf("G7 PERF: %s frequency hardware not enabled; left alone\n", name);
+		return;
+	}
+	uint32_t khz[G7P_ROWS];
+	unsigned n = 0, top = 0;
+	uint32_t prev = 0;
+	for (unsigned i = 0; i < G7P_ROWS; i++) {
+		uint32_t row = g7p_rd(b, G7P_LUT + i * G7P_ROW);
+		uint32_t src = (row >> 30) & 3u, lval = row & 0xffu, cores = (row >> 16) & 7u;
+		uint32_t f = src ? lval * G7P_XO_KHZ : 0;
+		if (i > 0 && f == prev) {
+			break;          /* a repeated row ends the table */
+		}
+		khz[i] = (cores == 1u) ? 0 : f;  /* core count 1 marks a boost level: skip */
+		if (khz[i] > khz[top]) {
+			top = i;
+		}
+		prev = f;
+		n = i + 1;
+	}
+	if (n == 0 || khz[top] == 0) {
+		printf("G7 PERF: %s empty frequency table\n", name);
+		return;
+	}
+	uint32_t want = (uint32_t)((uint64_t)khz[top] * pct / 100u), pick = 0;
+	for (unsigned i = 0; i < n; i++) {
+		if (khz[i] && khz[i] <= want && khz[i] >= khz[pick]) {
+			pick = i;
+		}
+	}
+	uint32_t before = g7p_rd(b, G7P_STATE), vote = g7p_rd(b, G7P_VOTE) & 0x3ffu;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + G7P_STATE) = pick;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	printf("G7 PERF: %s %u levels, max %u MHz; level %u (%u MHz) -> level %u (%u MHz), now %u MHz\n",
+	    name, n, khz[top] / 1000u, before, before < n ? khz[before] / 1000u : 0, pick,
+	    khz[pick] / 1000u, ((g7p_rd(b, G7P_VOTE) & 0x3ffu) * G7P_XO_KHZ) / 1000u);
+	(void)vote;
+}
+
+void
+g7_perf_init(void)
+{
+	unsigned pct = 85;
+	(void)PE_parse_boot_argn("g7perf", &pct, sizeof(pct));
+	if (pct == 0) {
+		printf("G7 PERF: off (g7perf=0)\n");
+		return;
+	}
+	if (pct > 100) {
+		pct = 100;
+	}
+	for (unsigned d = 0; d < sizeof(g7p_domains) / sizeof(g7p_domains[0]); d++) {
+		g7p_domain(g7p_domains[d].name, g7p_domains[d].pa, pct);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
