+/* One BGRA pixel at level/256 brightness (two channels per multiply). */
+static inline uint32_t
+sweet_fb_dim(uint32_t p, uint32_t level)
+{
+	if (level >= 256) {
+		return p;
+	}
+	uint32_t rb = (((p & 0x00ff00ffu) * level) >> 8) & 0x00ff00ffu;
+	uint32_t g = (((p & 0x0000ff00u) * level) >> 8) & 0x0000ff00u;
+	return (p & 0xff000000u) | rb | g;
+}
