+static void
+g7p_thermal(void *arg __unused, wait_result_t wr __unused)
+{
+	vm_offset_t ts = ml_io_map(G7P_TSENS_TM, 0x1000);
+	if (!ts) {
+		printf("G7 PERF: thermal sensors map failed; guard off\n");
+		(void)thread_terminate(current_thread());
+		return;
+	}
+	unsigned reports = 0;
+	for (;;) {
+		int hot = g7p_hottest(ts);
+		unsigned cap = g7p_cap;
+		if (hot >= G7P_VHOT_C10) {
+			cap = G7P_FLOOR_PCT;
+		} else if (hot >= G7P_HOT_C10) {
+			cap = cap > G7P_FLOOR_PCT + 10u ? cap - 10u : G7P_FLOOR_PCT;
+		} else if (hot > -1000 && hot < G7P_COOL_C10 && cap < g7p_limit) {
+			cap = cap + 5u < g7p_limit ? cap + 5u : g7p_limit;
+		}
+		if (cap != g7p_cap && !g7_screen_on) {
+			g7p_cap = cap;              /* asleep: stays at the lowest level; the cap applies on wake */
+		} else if (cap != g7p_cap) {
+			printf("G7 PERF: CPU %d.%d C -> speed %u %% (limit %u %%)\n", hot / 10, (hot < 0 ? -hot : hot) % 10,
+			    cap, g7p_limit);
+			g7p_cap = cap;
+			g7p_apply(cap);
+		} else if (reports < 5) {
+			printf("G7 PERF: CPU %d.%d C, speed %u %%\n", hot / 10, (hot < 0 ? -hot : hot) % 10, cap);
+			reports++;
+		}
+		g7p_sleep(2000);
+	}
+}
