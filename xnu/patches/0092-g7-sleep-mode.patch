+/*
+ * Wake from sleep mode: the SW49410 drives the panel too (TDDI), so turning
+ * the display off and on can leave its touch side unconfigured, and touch
+ * stopped after a screen-off. Send the same start-up writes as at boot.
+ */
+static void
+g7_wake_init(unsigned do_init)
+{
+	unsigned bad = 0;
+	if (do_init == 1) {
+		static const uint32_t seq[5][2] = {
+			{0xFE1, 0x07}, {0xFE2, 0x01}, {0xC00, 0x01}, {0xC01, 0x01}, {0xC03, 0x181},
+		};
+		for (unsigned i = 0; i < 5 && !g7.dead; ++i) {
+			uint32_t a = seq[i][0], v = seq[i][1];
+			g7.tx[0] = (uint8_t)(0x40u | ((a >> 8) & 0x0fu));
+			g7.tx[1] = (uint8_t)a;
+			g7.tx[2] = (uint8_t)v;
+			g7.tx[3] = (uint8_t)(v >> 8);
+			g7.tx[4] = (uint8_t)(v >> 16);
+			g7.tx[5] = (uint8_t)(v >> 24);
+			if (g7_spi(6)) {
+				bad++;
+			}
+			g7_sleep(i == 4 ? 30 : 10);
+		}
+	} else if (do_init == 2) {
+		for (unsigned i = 0; i < 8 && !g7.dead; ++i) {
+			bcopy(g7_init_seq[i], g7.tx, 6);
+			if (g7_spi(6)) {
+				bad++;
+			}
+			g7_sleep(100);
+		}
+	}
+	printf("G7 TOUCH: display on, touch re-initialised (%u errors)\n", bad);
+}
