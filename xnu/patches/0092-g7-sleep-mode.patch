+/* Hottest valid CPU sensor in tenths of a degree C; -1000 when none reads. */
+static int
+g7p_hottest(vm_offset_t ts)
+{
+	int hot = -1000;
+	for (unsigned i = 0; i < sizeof(g7p_sensors) / sizeof(g7p_sensors[0]); i++) {
+		uint32_t st = g7p_rd(ts, G7P_TS_STATUS + 4u * g7p_sensors[i]);
+		if (!(st & (1u << 21))) {
+			continue;
+		}
+		int c10 = (int)(st & 0xfffu);
+		if (c10 & 0x800) {
+			c10 -= 0x1000;          /* 12-bit signed */
+		}
+		if (c10 > hot) {
+			hot = c10;
+		}
+	}
+	return hot;
+}
+
+/* Both clusters to the highest level at or below pct % of their top level. */
+static void
+g7p_apply(unsigned pct)
+{
+	for (unsigned d = 0; d < 2; d++) {
+		if (!g7p_dom[d].base || !g7p_dom[d].n) {
+			continue;
+		}
+		uint32_t want = (uint32_t)((uint64_t)g7p_dom[d].khz[g7p_dom[d].top] * pct / 100u);
+		unsigned pick = 0;
+		for (unsigned i = 0; i < g7p_dom[d].n; i++) {
+			if (g7p_dom[d].khz[i] && g7p_dom[d].khz[i] <= want && g7p_dom[d].khz[i] >= g7p_dom[d].khz[pick]) {
+				pick = i;
+			}
+		}
+		if (pick != g7p_dom[d].level) {
+			__asm__ volatile ("dmb oshst" ::: "memory");
+			*(volatile uint32_t *)(g7p_dom[d].base + G7P_STATE) = pick;
+			__asm__ volatile ("dsb osh" ::: "memory");
+			g7p_dom[d].level = pick;
+		}
+	}
+}
+
+/* Display power from SweetFramebuffer: sleep mode off/on. */
+void
+g7_display_power(int on)
+{
+	if (on == g7_screen_on) {
+		return;
+	}
+	g7_screen_on = on;
+	g7p_apply(on ? g7p_cap : 0);        /* 0 %: every level is above it, so level 0, the lowest */
+	printf("G7 PERF: display %s: %s\n", on ? "on" : "off", on ? "speed restored" : "sleep mode (lowest CPU speed)");
+}
+
+static void
+g7p_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&g7p_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
