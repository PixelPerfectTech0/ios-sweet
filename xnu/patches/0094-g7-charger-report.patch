+/*
+ * G7 charger report (read only): the PMI8998 SMB2 registers that decide whether and how fast it charges, as raw bytes, at the first
+ * poll, whenever the charger state or USB presence changes, and every 2 minutes. CHGR 0x10: status 1/2/3/7/8, INT_RT, enable cmd,
+ * CFG2, fast-charge current, float voltage. BATIF 0x12: INT_RT. USBIN 0x13: APSD status/result, INT_RT, CMD_IL, ICL options,
+ * ICL setting. MISC 0x16: ICL now, AICL status, power path, INT_RT, watchdog config, bark/bite config.
+ */
+static void
+g7ChargerReport(uint8_t charger, uint8_t usb)
+{
+	static unsigned polls;
+	static int last = -1;
+	const int now = (int)((charger & 7u) | ((usb & 0x10u) << 4));
+	if (polls++ % 4 != 0 && now == last) {
+		return;
+	}
+	last = now;
+	static const uint16_t regs[] = {
+		0x1006, 0x1007, 0x1008, 0x100d, 0x100e, 0x1010, 0x1042, 0x1051, 0x1061, 0x1070,
+		0x1210,
+		0x1307, 0x1308, 0x1310, 0x1340, 0x1366, 0x1370,
+		0x1607, 0x160a, 0x160b, 0x1610, 0x1651, 0x1653,
+	};
+	uint8_t v[sizeof(regs) / sizeof(regs[0])];
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		if (sweet_spmi_read(2, regs[i], &v[i])) {
+			v[i] = 0xee;
+		}
+	}
+	IOLog("SWEET CHG: chgr st %02x %02x %02x %02x %02x rt %02x en %02x cfg2 %02x fcc %02x fv %02x | bat rt %02x\n",
+	    v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10]);
+	IOLog("SWEET CHG: usb apsd %02x %02x rt %02x il %02x iclopt %02x icl %02x | misc icl %02x aicl %02x path %02x rt %02x wd %02x %02x\n",
+	    v[11], v[12], v[13], v[14], v[15], v[16], v[17], v[18], v[19], v[20], v[21], v[22]);
+}
+
+/*
+ * G7: what the USB port is plugged into. The PMI8998 detects it in hardware (APSD, USBIN 0x1308: bit 0 SDP = a computer's
+ * USB port, 1 OCP = proprietary charger, 2 CDP = a computer's charging port, 3 DCP = wall charger, 4 float = unknown,
+ * 5/6 Quick Charge 2/3) and MISC 0x1607 holds the input current it allows now, in 25 mA steps (diag24 on the PC: SDP,
+ * 0x14 = 500 mA). Published the way iOS reads a power adapter: AdapterDetails with an IOPSKeys.h FamilyCode.
+ */
+void
+SweetBattery::publishG7Adapter(bool external)
+{
+	uint8_t apsd = 0, icl = 0;
+	const bool ok = external && !sweet_spmi_read(2, 0x1308, &apsd) && !sweet_spmi_read(2, 0x1607, &icl);
+	UInt32 family = 0xe0024000u;            /* kIOPSFamilyCodeDisconnected */
+	const char *what = "nothing";
+	if (ok) {
+		if (apsd & 0x60u) {
+			family = 0xe0004004u;           /* kIOPSFamilyCodeUSBChargingPortDedicated */
+			what = "wall charger (Quick Charge)";
+		} else if (apsd & 0x08u) {
+			family = 0xe0004004u;
+			what = "wall charger";
+		} else if (apsd & 0x04u) {
+			family = 0xe0004005u;           /* kIOPSFamilyCodeUSBChargingPortDownstream */
+			what = "computer (charging USB port)";
+		} else if (apsd & 0x01u) {
+			family = 0xe0004000u;           /* kIOPSFamilyCodeUSBHost */
+			what = "computer (USB port)";
+		} else if (apsd & 0x02u) {
+			family = 0xe0004006u;           /* kIOPSFamilyCodeUSBChargingPort */
+			what = "charger (proprietary)";
+		} else {
+			family = 0xe0004007u;           /* kIOPSFamilyCodeUSBUnknown: floating data lines or not detected yet */
+			what = "charger (unknown type)";
+		}
+	} else if (external) {
+		family = 0xe0004007u;
+		what = "charger (unreadable)";
+	}
+	const unsigned ma = ok ? (unsigned)icl * 25u : 0u;
+	unsigned watts = (ma * 5u + 500u) / 1000u;
+	if (external && watts == 0) {
+		watts = 1;
+	}
+	OSDictionary *details = OSDictionary::withCapacity(8);
+	OSArray *raw = OSArray::withCapacity(1);
+	if (details) {
+		const struct {
+			const char *key;
+			UInt32 value;
+		} numbers[] = {
+			{"FamilyCode", family}, {"Watts", watts}, {"Current", ma}, {"Voltage", external ? 5000u : 0u},
+			{"AdapterID", 0}, {"Source", 0}, {"SweetAPSD", apsd},
+		};
+		for (unsigned i = 0; i < sizeof(numbers) / sizeof(numbers[0]); i++) {
+			OSNumber *number = OSNumber::withNumber(numbers[i].value, 32);
+			if (number) {
+				details->setObject(numbers[i].key, number);
+				number->release();
+			}
+		}
+		OSString *name = OSString::withCString(what);
+		if (name) {
+			details->setObject("Description", name);
+			details->setObject("Name", name);
+			name->release();
+		}
+		const OSSymbol *key = OSSymbol::withCString("AdapterDetails");
+		if (key) {
+			setPSProperty(key, details);
+			key->release();
+		}
+		if (raw) {
+			raw->setObject(details);
+			key = OSSymbol::withCString("AppleRawAdapterDetails");
+			if (key) {
+				setPSProperty(key, raw);
+				key->release();
+			}
+		}
+		details->release();
+	}
+	OSSafeReleaseNULL(raw);
+	const int now = external ? (int)((unsigned)apsd | (unsigned)icl << 8 | 1u << 16) : 0;
+	if (now != fLastG7Adapter) {
+		IOLog("SWEET CHG: connected to %s, input limit %u mA (%u W), apsd %02x\n", what, ma, watts, apsd);
+		fLastG7Adapter = now;
+	}
+}
