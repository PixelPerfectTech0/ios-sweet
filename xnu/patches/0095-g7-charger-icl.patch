diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index a89579f..fd4ad33 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -1,7 +1,7 @@
 /*
  * Battery-only adaptation of input/sweet_keys.c, observer EXT_READL.
- * PMIC READ ONLY. The only MMIO store issues a one-byte read command.
- * No interrupt clear, peripheral enable, charger config, or PMIC writes.
+ * PMIC reads through the observer. One write, G7 only: the PMI8998 input
+ * current limit (sweet_spmi_write). No interrupt clear or peripheral enable.
  * Init is serialized by the single built-in SweetBattery personality.
  * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
  */
@@ -17,6 +17,7 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 #define SP_CORE_PA 0x0c440000u
 #define SP_OBS_PA  0x0e600000u
 #define SP_CFG_PA  0x0c40a000u
+#define SP_CHNLS_PA 0x0c600000u   /* owner channels: 0x10000 per APID (spmi-pmic-arb v5) */
 #define SP_NO_APID 0xffffu
 
 static vm_offset_t sp_core, sp_obs, sp_cfg;
@@ -126,4 +127,49 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+
+/*
+ * G7: the one PMIC write this kernel makes. PMI8998 (SID 2) USBIN_CURRENT_LIMIT_CFG 0x1370, the input current limit in 25 mA
+ * steps that the charger uses in high-current mode (ICL options 0x1366 bit 0, already set by the bootloader). Anything else
+ * is refused. Owner channel EXT_WRITEL (opcode 0, one byte): WDATA0 at +0x10, command at +0x00, status at +0x08, only when
+ * this EE (0, the application processor) owns the peripheral.
+ */
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	static vm_offset_t chan[512];
+	if (!sp_ready || sid != 2 || addr != 0x1370u) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || apid >= 512 || sp_poisoned[apid] || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		return -2;
+	}
+	if (!chan[apid]) {
+		chan[apid] = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+		if (!chan[apid]) {
+			IOLockUnlock(sp_lock);
+			return -3;
+		}
+	}
+	const vm_offset_t c = chan[apid];
+	*(volatile uint32_t *)(c + 0x10u) = value;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(c + 0x00u) = (0u << 27) | ((addr & 0xffu) << 4); /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(c, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			return (status & 0x0eu) ? -4 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI write timeout sid=%u addr=%#x APID=%u disabled\n", sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -5;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
index 45565d1..3708626 100644
--- a/bsd/dev/sweet_spmi.h
+++ b/bsd/dev/sweet_spmi.h
@@ -8,6 +8,8 @@ extern "C" {
 int sweet_spmi_init(void);
 /* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
 int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/* G7 only: PMI8998 0x1370 (input current limit); every other address is refused. 0 success. */
+int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value);
 #ifdef __cplusplus
 }
 #endif
