+static void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
 static uint32_t
 usb_rd(vm_offset_t base, uint32_t off)
 {
@@ -73,6 +81,32 @@ usb_rd(vm_offset_t base, uint32_t off)
 	return v;
 }
 
+/* G7: where the bring-up stopped, repeated so it can be read after boot. */
+extern kern_return_t thread_terminate(thread_t);
+static const char *usb_stage = "starting";
+static vm_offset_t usb_status_dwc, usb_status_phy;
+static int usb_status_chan;
+
+static void
+usb_status_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (int i = 0; i < 60; i++) {
+		uint64_t deadline;
+		clock_interval_to_deadline(10000, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&usb_status_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (usb_status_dwc) {
+			printf("SWEET USB: status [%s] DSTS 0x%08x DCTL 0x%08x GEVNTCOUNT 0x%08x PHY_PLL 0x%08x\n",
+			    usb_stage, usb_rd(usb_status_dwc, 0xc70c), usb_rd(usb_status_dwc, 0xc704),
+			    usb_rd(usb_status_dwc, 0xc40c),
+			    usb_status_phy ? usb_rd(usb_status_phy, 0x1a0) : 0xdeadu);
+		} else {
+			printf("SWEET USB: status [%s]\n", usb_stage);
+		}
+	}
+	(void)thread_terminate(current_thread());
+}
