--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -15,6 +15,7 @@
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_key(int key, int down);
+extern void sweet_hid_usage(unsigned page, unsigned usage, int down);
 void sweet_keys_init(void);
 
 #define KEYS_CORE_PA     0x0c440000u
@@ -23,11 +24,40 @@ void sweet_keys_init(void);
 #define KEYS_PON_RT      0x0810u
 #define KEYS_GPIO_RT     0xc110u
 #define KEYS_NO_APID     0xffffu
+/*
+ * LG G7 (judyln, PM8998): volume up is PM8998 GPIO6 (SID 0, PPID 0x0c5;
+ * the register offsets below only use the low byte), and the Google
+ * Assistant key is TLMM gpio89 (SOUTH tile, active low). The assistant
+ * key acts as the ring/silent switch: boot-arg sweetkeys_ai=2 (default)
+ * latches - each press flips silent on/off and sends HID usage
+ * sweetkeys_ai_page/sweetkeys_ai_usage (default Telephony 0x0B / 0x2D)
+ * down for silent, up for ring; sweetkeys_ai=3 sends that usage as a
+ * plain press/release; 1 reports it as Home; 0 disables it.
+ */
+#define KEYS_VOLUP_PPID  0x0c5u
+#define KEYS_AI_CFG_PA   (0x03400000u + 0x00900000u + 89u * 0x1000u)
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
 static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
 static uint32_t keys_version, keys_last_status;
 static bool keys_started;
+static vm_offset_t keys_ai;
+static unsigned keys_ai_mode = 2, keys_ai_page = 0x0bu, keys_ai_usage = 0x2du;
+static int keys_ai_silent;
+
+static void
+keys_ai_event(int down)
+{
+	if (keys_ai_mode == 1) {
+		sweet_hid_key(3, down);
+	} else if (keys_ai_mode == 3) {
+		sweet_hid_usage(keys_ai_page, keys_ai_usage, down);
+	} else if (keys_ai_mode == 2 && down) {
+		keys_ai_silent = !keys_ai_silent;
+		printf("SWEET KEYS: ring/silent switch -> %s\n", keys_ai_silent ? "silent" : "ring");
+		sweet_hid_usage(keys_ai_page, keys_ai_usage, keys_ai_silent);
+	}
+}
 static int keys_sleep_chan;
 
 static uint32_t
@@ -93,7 +123,7 @@ keys_wait(void)
 static void
 keys_thread(void *arg, wait_result_t result)
 {
-	int state[3] = {0, 0, 0};
+	int state[4] = {0, 0, 0, 0};
 	unsigned errors = 0;
 	(void)arg;
 	(void)result;
@@ -101,7 +131,8 @@ keys_thread(void *arg, wait_result_t result)
 		uint8_t pon = 0, gpio = 0;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
-		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		int now[4] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u),
+		    keys_ai ? !(keys_rd(keys_ai, 4) & 1u) : 0};
 		if (!pok || !gok) {
 			if ((errors++ % 250u) == 0) {
 				printf("SWEET KEYS: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
@@ -110,12 +141,17 @@ keys_thread(void *arg, wait_result_t result)
 		} else {
 			errors = 0;
 		}
-		for (int k = 0; k < 3; ++k) {
-			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+		for (int k = 0; k < 4; ++k) {
+			bool ok = k == 3 ? keys_ai != 0 : (k == 1 ? gok : pok);
+			if (ok && now[k] != state[k]) {
 				state[k] = now[k];
 				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
 				    k, state[k], pon, gpio);
-				sweet_hid_key(k, state[k]);
+				if (k == 3) {
+					keys_ai_event(state[k]);
+				} else {
+					sweet_hid_key(k, state[k]);
+				}
 			}
 		}
 		keys_wait();
@@ -152,7 +188,7 @@ sweet_keys_init(void)
 		return;
 	}
 	keys_pon_apid = keys_find_apid(0x008, count);
-	keys_gpio_apid = keys_find_apid(0x4c1, count);
+	keys_gpio_apid = keys_find_apid(KEYS_VOLUP_PPID, count);
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
 	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
@@ -166,9 +202,27 @@ sweet_keys_init(void)
 	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
 	    mode & 3u : (mode >> 4) & 7u;
 	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
-		printf("SWEET KEYS: GPIO2 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
+		printf("SWEET KEYS: G7 PM8998 GPIO6 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
 		keys_gpio_apid = KEYS_NO_APID;
 	}
+	(void)PE_parse_boot_argn("sweetkeys_ai", &keys_ai_mode, sizeof(keys_ai_mode));
+	(void)PE_parse_boot_argn("sweetkeys_ai_page", &keys_ai_page, sizeof(keys_ai_page));
+	(void)PE_parse_boot_argn("sweetkeys_ai_usage", &keys_ai_usage, sizeof(keys_ai_usage));
+	if (keys_ai_mode) {
+		keys_ai = ml_io_map(KEYS_AI_CFG_PA, 0x1000);
+	}
+	if (keys_ai) {
+		/* gpio89: plain GPIO input with pull-up (function 0, output off). */
+		uint32_t cfg = keys_rd(keys_ai, 0);
+		cfg = (cfg & ~0x23fu) | 3u;
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)keys_ai = cfg;
+		__asm__ volatile("dsb osh" ::: "memory");
+		delay(100);
+		printf("SWEET KEYS: G7 assistant key gpio89 cfg=%#x in=%u mode %u usage %#x/%#x\n",
+		    keys_rd(keys_ai, 0), keys_rd(keys_ai, 4) & 1u, keys_ai_mode,
+		    keys_ai_page, keys_ai_usage);
+	}
 	if (!pok && !gok) {
 		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
 	}
