--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -23,11 +23,20 @@ void sweet_keys_init(void);
 #define KEYS_PON_RT      0x0810u
 #define KEYS_GPIO_RT     0xc110u
 #define KEYS_NO_APID     0xffffu
+/*
+ * LG G7 (judyln, PM8998): volume up is PM8998 GPIO6 (SID 0, PPID 0x0c5;
+ * the register offsets below only use the low byte), and the Google
+ * Assistant key is TLMM gpio89 (SOUTH tile, active low). The assistant
+ * key is reported as Home (boot-arg sweetkeys_ai=0 disables it).
+ */
+#define KEYS_VOLUP_PPID  0x0c5u
+#define KEYS_AI_CFG_PA   (0x03400000u + 0x00900000u + 89u * 0x1000u)
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
 static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
 static uint32_t keys_version, keys_last_status;
 static bool keys_started;
+static vm_offset_t keys_ai;
 static int keys_sleep_chan;
 
 static uint32_t
@@ -93,7 +102,7 @@ keys_wait(void)
 static void
 keys_thread(void *arg, wait_result_t result)
 {
-	int state[3] = {0, 0, 0};
+	int state[4] = {0, 0, 0, 0};
 	unsigned errors = 0;
 	(void)arg;
 	(void)result;
@@ -101,7 +110,8 @@ keys_thread(void *arg, wait_result_t result)
 		uint8_t pon = 0, gpio = 0;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
-		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		int now[4] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u),
+		    keys_ai ? !(keys_rd(keys_ai, 4) & 1u) : 0};
 		if (!pok || !gok) {
 			if ((errors++ % 250u) == 0) {
 				printf("SWEET KEYS: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
@@ -110,8 +120,9 @@ keys_thread(void *arg, wait_result_t result)
 		} else {
 			errors = 0;
 		}
-		for (int k = 0; k < 3; ++k) {
-			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+		for (int k = 0; k < 4; ++k) {
+			bool ok = k == 3 ? keys_ai != 0 : (k == 1 ? gok : pok);
+			if (ok && now[k] != state[k]) {
 				state[k] = now[k];
 				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
 				    k, state[k], pon, gpio);
@@ -152,7 +163,7 @@ sweet_keys_init(void)
 		return;
 	}
 	keys_pon_apid = keys_find_apid(0x008, count);
-	keys_gpio_apid = keys_find_apid(0x4c1, count);
+	keys_gpio_apid = keys_find_apid(KEYS_VOLUP_PPID, count);
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
 	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
@@ -166,9 +177,25 @@ sweet_keys_init(void)
 	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
 	    mode & 3u : (mode >> 4) & 7u;
 	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
-		printf("SWEET KEYS: GPIO2 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
+		printf("SWEET KEYS: G7 PM8998 GPIO6 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
 		keys_gpio_apid = KEYS_NO_APID;
 	}
+	int ai = 1;
+	(void)PE_parse_boot_argn("sweetkeys_ai", &ai, sizeof(ai));
+	if (ai) {
+		keys_ai = ml_io_map(KEYS_AI_CFG_PA, 0x1000);
+	}
+	if (keys_ai) {
+		/* gpio89: plain GPIO input with pull-up (function 0, output off). */
+		uint32_t cfg = keys_rd(keys_ai, 0);
+		cfg = (cfg & ~0x23fu) | 3u;
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)keys_ai = cfg;
+		__asm__ volatile("dsb osh" ::: "memory");
+		delay(100);
+		printf("SWEET KEYS: G7 assistant key gpio89 cfg=%#x in=%u (reported as Home)\n",
+		    keys_rd(keys_ai, 0), keys_rd(keys_ai, 4) & 1u);
+	}
 	if (!pok && !gok) {
 		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
 	}
