+/* G7 (sweetbattery=2): PMI8998 on SPMI SID 2. Returns false if unreadable. */
+bool
+SweetBattery::pollG7(void)
+{
+	uint8_t soc = 0, soc2 = 0, usb = 0, charger = 0;
+	int e1 = sweet_spmi_read(2, 0x4009, &soc), e2 = sweet_spmi_read(2, 0x4009, &soc2);
+	int e3 = sweet_spmi_read(2, 0x1310, &usb), e4 = sweet_spmi_read(2, 0x1006, &charger);
+	if (e1 || e2 || e3 || e4 || soc != soc2 || soc == 0) {
+		if (fG7Failures++ < 5) {
+			IOLog("SWEET BATTERY: G7 read failed: soc %d/%d (%#x/%#x) usb %d (%#x) charger %d (%#x)\n",
+			    e1, e2, soc, soc2, e3, usb, e4, charger);
+		}
+		return false;   /* unreadable, torn or not yet valid: keep the last value */
+	}
+	unsigned percent = ((unsigned)soc * 100u + 127u) / 255u;
+	if (percent < 1) {
+		percent = 1;
+	}
+	bool external = (usb & 0x10u) != 0;
+	unsigned state = charger & 7u;
+	bool full = external && (state == 5 || percent >= 100);
+	bool charging = external && state <= 4 && !full;
+	/* Rough voltage from the charge level, only for the battery details page. */
+	unsigned mv = 3400 + percent * 8;
+	publish(full ? 100 : percent, mv, 0, external, external, charging, full, true, false);
+	if (fLastG7Percent != (int)percent || fLastG7State != (int)state || fLastG7Usb != (int)external) {
+		IOLog("SWEET BATTERY: G7 PMI8998 soc %u/255 = %u%%, usb %d, charger state %u\n",
+		    soc, percent, external, state);
+		fLastG7Percent = (int)percent;
+		fLastG7State = (int)state;
+		fLastG7Usb = (int)external;
+	}
+	return true;
+}
