+/*
+ * LG G7 ThinQ (judyln, SDM845): SiliconWorks SW49410 in-cell touch over SPI.
+ *
+ * Bus: QUPv3 wrap0 SE5 (spi5, 0x00894000), CS0, mode 0, 8-bit words, FIFO
+ * mode, polled. Pins: TLMM gpio85-88 = qup5 (EAST tile), gpio31 = touch
+ * IRQ (input, active low), gpio32 = touch reset (active low) (NORTH tile).
+ * Protocol (from the sdm845-mainline sw49410-ts-spi driver):
+ *   read  addr: tx 0x20|(addr>>8&0xf), addr&0xff, 4 dummy; data at rx+6
+ *   write addr: tx 0x40|(addr>>8&0xf), addr&0xff, data...
+ *   init: eight raw 6-byte writes, 100 ms apart
+ *   report: 132 bytes from 0x200 = 12-byte header + 10 x 12-byte contacts
+ * The SW49410 is a TDDI (it also drives the panel), so the reset pulse is
+ * off by default (g7touch_reset=1 enables it): it might blank the display.
+ *
+ * Boot-args: g7touch=0 disables, g7touchdelay=N seconds (default 30),
+ * g7touch_reset=1, g7touch_init=0 skips the init writes, g7touch_div=N SPI
+ * clock divider override.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_g7touch_init(void);
+
+#define G7_SE_PA        0x00894000u     /* QUPv3 wrap0 SE5 */
+#define G7_GCC_PA       0x00100000u
+#define G7_NORTH_PA     0x03900000u     /* TLMM 0x3400000 + NORTH 0x500000 */
+#define G7_EAST_PA      0x03500000u     /* TLMM 0x3400000 + EAST 0x100000 */
+#define G7_GCC_VOTE     0x5200cu        /* APCS_CLOCK_BRANCH_ENA_VOTE_1 */
+#define G7_RCG          0x17624u        /* gcc_qupv3_wrap0_s5_clk_src */
+#define G7_GPIO_CFG(n)  ((uint32_t)(n) * 0x1000u)
+#define G7_GPIO_IO(n)   (G7_GPIO_CFG(n) + 4u)
+#define G7_BB_MISO      85u     /* QUP SE5 pin order: MISO, MOSI, CLK, CS */
+#define G7_BB_MOSI      86u
+#define G7_BB_CLK       87u
+#define G7_BB_CS        88u
+#define G7_IRQ_GPIO     31u
+#define G7_RST_GPIO     32u
+#define G7_MAX          10u
+#define G7_PANEL_W      1440
+#define G7_PANEL_H      3120
+/* Panel -> SweetHID coordinates. The 1125x2436 iPhone X image is stretched
+ * over the whole panel (SweetFramebuffer, sweetfb_scale=1, the default) or
+ * centred on it at (157, 342); SweetHID adds (22, 18) for its 1080x2400 base. */
+#define G7_LOG_W        1125
+#define G7_LOG_H        2436
+#define G7_HID_OX       22
+#define G7_HID_OY       18
+
+/*
+ * Status strip: 8 coloured blocks, 120 rows tall at panel row 2200, drawn
+ * by the poll loop and again after every frame by AppleCLCD::present() so
+ * they stay visible over the GUI (boot-arg g7touch_bar=0 hides it). Blocks: 1 started, 2 clocks, 3 SPI engine, 4 first SPI read,
+ * 5 chip answers, 6 init writes, 7 polling, 8 touch seen (flips blue/green
+ * on every touch). Grey = not reached, green = OK, red = failed,
+ * yellow = suspicious (chip returned only zeros).
+ */
+#define G7_BAR_ROWS     120u
+#define G7_BAR_Y        2200u   /* panel row: the empty middle of the lock screen */
+#define G7_GREY         0xff606060u
+#define G7_GREEN        0xff00c000u
+#define G7_RED          0xffe00000u
+#define G7_YELLOW       0xffe0e000u
+#define G7_BLUE         0xff0060ffu
+
+/* GENI */
+#define SE_FORCE_DEFAULT 0x020u
+#define SE_OUTPUT_CTRL  0x024u
+#define SE_CGC_CTRL     0x028u
+#define SE_STATUS       0x040u
+#define SE_M_CLK_CFG    0x048u
+#define SE_IF_DISABLE   0x064u
+#define SE_FW_REV       0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_SPI_CPHA     0x224u
+#define SE_SPI_LOOPBACK 0x22cu
+#define SE_SPI_CPOL     0x230u
+#define SE_SPI_DEMUX_INV 0x24cu
+#define SE_SPI_DEMUX_SEL 0x250u
+#define SE_BYTE_GRAN    0x254u
+#define SE_DMA_MODE_EN  0x258u
+#define SE_SPI_TRANS_CFG 0x25cu
+#define SE_TX_PACK0     0x260u
+#define SE_TX_PACK1     0x264u
+#define SE_SPI_WORD_LEN 0x268u
+#define SE_SPI_TX_LEN   0x26cu
+#define SE_SPI_RX_LEN   0x270u
+#define SE_RX_PACK0     0x284u
+#define SE_RX_PACK1     0x288u
+#define SE_M_CMD0       0x600u
+#define SE_M_CMD_CTRL   0x604u
+#define SE_M_IRQ        0x610u
+#define SE_M_IRQ_EN     0x614u
+#define SE_M_IRQ_CLR    0x618u
+#define SE_S_IRQ_EN     0x644u
+#define SE_S_IRQ_CLR    0x648u
+#define SE_TX_FIFO      0x700u
+#define SE_RX_FIFO      0x780u
+#define SE_TX_STATUS    0x800u
+#define SE_RX_STATUS    0x804u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM        0x810u
+#define SE_RX_RFR_WM    0x814u
+#define SE_GSI_EVENT_EN 0xe18u
+#define SE_IRQ_EN       0xe1cu
+#define SE_HW_PARAM0    0xe24u
+#define SE_HW_PARAM1    0xe28u
+#define SE_DMA_GEN_CFG  0xe30u
+
+#define M_CMD_DONE      (1u << 0)
+#define M_CMD_ABORT     (1u << 5)
+#define M_ERRORS        ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 24) | \
+                         (1u << 25) | (1u << 28) | (1u << 29))
+#define SPI_FULL_DUPLEX 3u              /* SPI_TX_ONLY | SPI_RX_ONLY */
+
+#define G7_XFER_MAX     160u
+
+static struct {
+	vm_offset_t se, gcc, north, east;
+	bool started, dead;
+	bool bb, cpol;          /* bit-banged SPI, SPI mode 3 */
+	unsigned txdepth;
+	uint32_t active, irq;
+	int x[G7_MAX], y[G7_MAX];
+	uint8_t tx[G7_XFER_MAX], rx[G7_XFER_MAX];
+	bool scaled;
+	vm_offset_t bar;
+	uint32_t bar_w, bar_stride;
+	uint32_t stage[8];
+	unsigned touches;
+} g7;
+static int g7_sleep_chan;
+
+static void
+g7_bar_init(void)
+{
+	PE_Video v;
+	unsigned on = 1;
+	(void)PE_parse_boot_argn("g7touch_bar", &on, sizeof(on));
+	for (unsigned i = 0; i < 8; ++i) {
+		g7.stage[i] = G7_GREY;
+	}
+	if (!on) {
+		return;
+	}
+	bzero(&v, sizeof(v));
+	PE_current_console(&v);
+	if (v.v_baseAddr == 0 || v.v_width < 64 || v.v_rowBytes < v.v_width * 4 ||
+	    v.v_height < G7_BAR_Y + G7_BAR_ROWS) {
+		return;
+	}
+	g7.bar = ml_io_map((vm_offset_t)v.v_baseAddr + (vm_offset_t)v.v_rowBytes * G7_BAR_Y,
+	    (vm_size_t)v.v_rowBytes * G7_BAR_ROWS);
+	g7.bar_w = (uint32_t)v.v_width;
+	g7.bar_stride = (uint32_t)v.v_rowBytes;
+}
+
+/* rows: G7_BAR_ROWS rows starting at the strip's first row */
+static void
+g7_bar_paint(uintptr_t rows, uint32_t stride, uint32_t w)
+{
+	uint32_t block = w / 8u;
+	for (uint32_t y = 0; y < G7_BAR_ROWS; ++y) {
+		volatile uint32_t *row = (volatile uint32_t *)(rows + (uintptr_t)y * stride);
+		for (uint32_t x = 0; x < w; ++x) {
+			uint32_t i = x / block;
+			/* 12-pixel black gap between blocks */
+			row[x] = (i >= 8u || (x % block) >= block - 12u) ? 0xff000000u : g7.stage[i];
+		}
+	}
+}
+
+static void
+g7_bar_draw(void)
+{
+	if (g7.bar) {
+		g7_bar_paint(g7.bar, g7.bar_stride, g7.bar_w);
+	}
+}
+
+/* Called by AppleCLCD::present() after each frame so the strip stays on top. */
+void sweet_g7touch_overlay(uintptr_t pixels, uint32_t stride, uint32_t w, uint32_t h);
+void
+sweet_g7touch_overlay(uintptr_t pixels, uint32_t stride, uint32_t w, uint32_t h)
+{
+	if (g7.bar && pixels && h >= G7_BAR_Y + G7_BAR_ROWS && w == g7.bar_w) {
+		g7_bar_paint(pixels + (uintptr_t)G7_BAR_Y * stride, stride, w);
+	}
+}
+
+static void
+g7_stage(unsigned i, uint32_t color)
+{
+	if (i >= 1 && i <= 8) {
+		g7.stage[i - 1] = color;
+	}
+	g7_bar_draw();
+}
+
+static uint32_t
+g7_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+g7_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+g7_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&g7_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+g7_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(g7_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* TLMM config: pull 0 none / 1 down / 3 up, drive = (mA / 2) - 1. */
+static void
+g7_gpio(vm_offset_t tile, unsigned pin, unsigned func, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t cfg = g7_rd(tile, G7_GPIO_CFG(pin));
+	if (out) {
+		uint32_t io = g7_rd(tile, G7_GPIO_IO(pin));
+		g7_wr(tile, G7_GPIO_IO(pin), high ? (io | 2u) : (io & ~2u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= pull | (func << 2) | (drive << 6) | (out ? 0x200u : 0u);
+	g7_wr(tile, G7_GPIO_CFG(pin), cfg);
+}
+
+static void
+g7_gpio_set(vm_offset_t tile, unsigned pin, bool high)
+{
+	uint32_t io = g7_rd(tile, G7_GPIO_IO(pin));
+	g7_wr(tile, G7_GPIO_IO(pin), high ? (io | 2u) : (io & ~2u));
+}
+
+/* Returns the SPI clock divider for a <= ~5 MHz bus, or 0 on failure. */
+static unsigned
+g7_clocks(void)
+{
+	/* wrap0 m_ahb (6), s_ahb (7), core (8), core_2x (9), s5 (15). */
+	uint32_t mask = (0x0fu << 6) | (1u << 15);
+	g7_wr(g7.gcc, G7_GCC_VOTE, g7_rd(g7.gcc, G7_GCC_VOTE) | mask);
+	uint32_t dfs = g7_rd(g7.gcc, G7_RCG + 0x14u);
+	uint32_t cfg = g7_rd(g7.gcc, G7_RCG + 4u);
+	unsigned div = 4; /* 19.2 MHz XO / 4 = 4.8 MHz */
+	printf("G7 TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    g7_rd(g7.gcc, G7_GCC_VOTE), g7_rd(g7.gcc, G7_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS level 0; tables are left alone. */
+		uint32_t l0 = g7_rd(g7.gcc, G7_RCG + 0x1cu);
+		printf("G7 TOUCH: DFS level0 cfg=%#x\n", l0);
+		if ((l0 & 0x371fu) != 1u) {
+			div = 24; /* unknown level-0 rate (<= 128 MHz): stay slow */
+		}
+	} else {
+		/* XO parent 0, divider 1 => 19.2 MHz. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		g7_wr(g7.gcc, G7_RCG + 4u, cfg);
+		g7_wr(g7.gcc, G7_RCG, g7_rd(g7.gcc, G7_RCG) | 1u);
+		if (!g7_wait_clear(g7.gcc, G7_RCG, 1u)) {
+			printf("G7 TOUCH: RCG update timeout\n");
+			return 0;
+		}
+	}
+	const uint32_t branches[] = {0x17004, 0x17008, 0x17620};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!g7_wait_clear(g7.gcc, branches[i], 1u << 31)) {
+			printf("G7 TOUCH: GCC branch %#x halted (%#x)\n", branches[i],
+			    g7_rd(g7.gcc, branches[i]));
+			return 0;
+		}
+	}
+	return div;
+}
+
+static bool
+g7_se_init(unsigned div)
+{
+	uint32_t fw = g7_rd(g7.se, SE_FW_REV);
+	uint32_t p0 = g7_rd(g7.se, SE_HW_PARAM0), p1 = g7_rd(g7.se, SE_HW_PARAM1);
+	printf("G7 TOUCH: se5 fw=%#x proto=%u ifdis=%#x status=%#x hw0=%#x hw1=%#x\n",
+	    fw, (fw >> 8) & 0xffu, g7_rd(g7.se, SE_IF_DISABLE),
+	    g7_rd(g7.se, SE_STATUS), p0, p1);
+	if (((fw >> 8) & 0xffu) != 1u || (g7_rd(g7.se, SE_IF_DISABLE) & 1u) ||
+	    ((p0 >> 24) & 0x3fu) != 32u || ((p1 >> 24) & 0x3fu) != 32u ||
+	    ((p0 >> 16) & 0x3fu) < 4u) {
+		printf("G7 TOUCH: SE5 is not a FIFO SPI engine; stopping\n");
+		return false;
+	}
+	g7.txdepth = (p0 >> 16) & 0x3fu;
+	unsigned rxdepth = (p1 >> 16) & 0x3fu;
+	if (g7_rd(g7.se, SE_STATUS) & 1u) {
+		printf("G7 TOUCH: SE5 busy; stopping\n");
+		return false;
+	}
+	/* geni_se_init / io_init / select_fifo_mode */
+	g7_wr(g7.se, SE_GSI_EVENT_EN, 0);
+	g7_wr(g7.se, SE_M_IRQ_CLR, 0xffffffffu);
+	g7_wr(g7.se, SE_S_IRQ_CLR, 0xffffffffu);
+	g7_wr(g7.se, SE_IRQ_EN, 0);      /* polled: nothing routed to the GIC */
+	g7_wr(g7.se, SE_CGC_CTRL, g7_rd(g7.se, SE_CGC_CTRL) | 0x7fu);
+	g7_wr(g7.se, SE_DMA_GEN_CFG, g7_rd(g7.se, SE_DMA_GEN_CFG) | 0x0fu);
+	g7_wr(g7.se, SE_OUTPUT_CTRL, 0x7f);
+	g7_wr(g7.se, SE_FORCE_DEFAULT, 1);
+	g7_wr(g7.se, SE_DMA_MODE_EN, 0);
+	g7_wr(g7.se, SE_RX_WM, rxdepth - 3u);
+	g7_wr(g7.se, SE_RX_RFR_WM, rxdepth - 2u);
+	g7_wr(g7.se, SE_TX_WM, 0);
+	g7_wr(g7.se, SE_S_IRQ_EN, 0);
+	g7_wr(g7.se, SE_M_IRQ_EN, M_CMD_DONE | M_CMD_ABORT | M_ERRORS |
+	    (1u << 26) | (1u << 27) | (1u << 30));
+	/* 8-bit words, four per FIFO word, LSB byte first. */
+	g7_wr(g7.se, SE_TX_PACK0, 0x0004380eu);
+	g7_wr(g7.se, SE_TX_PACK1, 0x000c3e0eu);
+	g7_wr(g7.se, SE_RX_PACK0, 0x0004380eu);
+	g7_wr(g7.se, SE_RX_PACK1, 0x000c3e0eu);
+	g7_wr(g7.se, SE_BYTE_GRAN, 0);
+	g7_wr(g7.se, SE_SPI_WORD_LEN, 8u - 4u);
+	g7_wr(g7.se, SE_SPI_TRANS_CFG, g7_rd(g7.se, SE_SPI_TRANS_CFG) & ~2u);
+	g7_wr(g7.se, SE_SPI_LOOPBACK, 0);
+	g7_wr(g7.se, SE_SPI_DEMUX_SEL, 0);
+	g7_wr(g7.se, SE_SPI_CPHA, 0);
+	g7_wr(g7.se, SE_SPI_CPOL, 0);
+	g7_wr(g7.se, SE_SPI_DEMUX_INV, 0);
+	g7_wr(g7.se, SE_CLK_SEL, 0);
+	g7_wr(g7.se, SE_M_CLK_CFG, (div << 4) | 1u);
+	if ((g7_rd(g7.se, SE_TX_STATUS) & 0xfffffffu) ||
+	    (g7_rd(g7.se, SE_RX_STATUS) & 0x1ffffffu)) {
+		printf("G7 TOUCH: inherited FIFO data; stopping\n");
+		return false;
+	}
+	printf("G7 TOUCH: SPI ready, div %u, txdepth %u rxdepth %u\n", div,
+	    g7.txdepth, rxdepth);
+	return true;
+}
+
+static void
+g7_abort(void)
+{
+	g7_wr(g7.se, SE_M_CMD_CTRL, 2u);
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (g7_rd(g7.se, SE_M_IRQ) & M_CMD_ABORT) {
+			break;
+		}
+		delay(1);
+	}
+	for (unsigned i = 0; i < 64 && (g7_rd(g7.se, SE_RX_STATUS) & 0x1ffffffu); ++i) {
+		(void)g7_rd(g7.se, SE_RX_FIFO);
+	}
+	g7_wr(g7.se, SE_M_IRQ_CLR, 0xffffffffu);
+	if (!g7_wait_clear(g7.se, SE_STATUS, 1u)) {
+		g7.dead = true;
+		printf("G7 TOUCH: abort failed; stopping\n");
+	}
+}
+
+/*
+ * Bit-banged SPI, MSB first, sampled on the rising clock edge (mode 0, or
+ * mode 3 with g7.cpol). Each TLMM access is a few hundred ns, so the clock
+ * stays around 1 MHz, well under the SW49410's limit.
+ */
+static void
+g7_bb_pin(unsigned pin, bool high)
+{
+	g7_wr(g7.east, G7_GPIO_IO(pin), high ? 2u : 0u);
+}
+
+static int
+g7_spi_bb(unsigned len)
+{
+	g7_bb_pin(G7_BB_CLK, g7.cpol);
+	g7_bb_pin(G7_BB_CS, false);
+	delay(2);
+	for (unsigned i = 0; i < len; ++i) {
+		uint8_t out = g7.tx[i], in = 0;
+		for (int b = 7; b >= 0; --b) {
+			if (g7.cpol) {
+				g7_bb_pin(G7_BB_CLK, false);
+			}
+			g7_bb_pin(G7_BB_MOSI, (out >> b) & 1u);
+			(void)g7_rd(g7.east, G7_GPIO_IO(G7_BB_MOSI));   /* settle */
+			g7_bb_pin(G7_BB_CLK, true);
+			(void)g7_rd(g7.east, G7_GPIO_IO(G7_BB_CLK));
+			in = (uint8_t)((in << 1) | (g7_rd(g7.east, G7_GPIO_IO(G7_BB_MISO)) & 1u));
+			if (!g7.cpol) {
+				g7_bb_pin(G7_BB_CLK, false);
+			}
+		}
+		g7.rx[i] = in;
+	}
+	delay(2);
+	g7_bb_pin(G7_BB_CS, true);
+	delay(5);
+	return 0;
+}
+
+/* One full-duplex transfer of len bytes with CS asserted throughout. */
+static int
+g7_spi(unsigned len)
+{
+	if (g7.dead || len == 0 || len > G7_XFER_MAX) {
+		return EIO;
+	}
+	if (g7.bb) {
+		return g7_spi_bb(len);
+	}
+	if (!g7_wait_clear(g7.se, SE_STATUS, 1u)) {
+		g7.dead = true;
+		return EBUSY;
+	}
+	g7_wr(g7.se, SE_M_IRQ_CLR, 0xffffffffu);
+	g7_wr(g7.se, SE_SPI_TX_LEN, len);
+	g7_wr(g7.se, SE_SPI_RX_LEN, len);
+	g7_wr(g7.se, SE_M_CMD0, SPI_FULL_DUPLEX << 27);
+	unsigned sent = 0, got = 0;
+	for (unsigned i = 0; i < 50000; ++i) {
+		uint32_t irq = g7_rd(g7.se, SE_M_IRQ);
+		g7.irq = irq;
+		if (irq & M_ERRORS) {
+			break;
+		}
+		uint32_t txc = g7_rd(g7.se, SE_TX_STATUS) & 0xfffffffu;
+		while (sent < len && txc < g7.txdepth) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < 4 && sent + j < len; ++j) {
+				word |= (uint32_t)g7.tx[sent + j] << (8u * j);
+			}
+			g7_wr(g7.se, SE_TX_FIFO, word);
+			sent += 4;
+			txc++;
+		}
+		uint32_t wc = g7_rd(g7.se, SE_RX_STATUS) & 0x1ffffffu;
+		while (wc--) {
+			uint32_t word = g7_rd(g7.se, SE_RX_FIFO);
+			for (unsigned j = 0; j < 4 && got < len; ++j) {
+				g7.rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		if ((irq & M_CMD_DONE) && got >= len) {
+			g7_wr(g7.se, SE_M_IRQ_CLR, irq);
+			return 0;
+		}
+		if (irq & M_CMD_DONE) {
+			/* DONE before the last RX words were drained: next pass. */
+			if (!(g7_rd(g7.se, SE_RX_STATUS) & 0x1ffffffu)) {
+				break;
+			}
+			continue;
+		}
+		g7_wr(g7.se, SE_M_IRQ_CLR, irq & ((1u << 26) | (1u << 27) | (1u << 30)));
+		delay(1);
+	}
+	g7_abort();
+	return EIO;
+}
+
+static int
+g7_reg_read(uint16_t addr, unsigned size)
+{
+	if (size + 6u > G7_XFER_MAX) {
+		return EINVAL;
+	}
+	bzero(g7.tx, size + 6u);
+	/* LG touch_sw49410.c: 0x20 for bursts, 0x00 for <= 4 bytes */
+	g7.tx[0] = (uint8_t)((size > 4u ? 0x20u : 0x00u) | ((addr >> 8) & 0x0fu));
+	g7.tx[1] = (uint8_t)addr;
+	return g7_spi(size + 6u); /* data at g7.rx + 6 */
+}
+
+/* After a 132-byte read: 0 = data varies, 1 = all 00, 2 = all ff, 3 = other constant. */
+static unsigned
+g7_rx_kind(void)
+{
+	const uint8_t *b = g7.rx + 6;
+	for (unsigned i = 1; i < 132u; ++i) {
+		if (b[i] != b[0]) {
+			return 0;
+		}
+	}
+	return b[0] == 0x00 ? 1u : (b[0] == 0xff ? 2u : 3u);
+}
+
+static uint16_t
+g7_le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | ((uint16_t)p[1] << 8));
+}
+
+static void
+g7_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < G7_MAX; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(g7.active & bit) || x[id] != g7.x[id] || y[id] != g7.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			g7.x[id] = x[id];
+			g7.y[id] = y[id];
+		} else if (g7.active & bit) {
+			sweet_hid_touch((int)id, 0, g7.x[id], g7.y[id]);
+		}
+	}
+	g7.active = mask;
+}
+
+static int
+g7_clamp(int v, int lo, int hi)
+{
+	return v < lo ? lo : (v > hi ? hi : v);
+}
+
+/* Read one report; returns 0 and updates contacts, or an error. */
+static int
+g7_poll(unsigned *frames)
+{
+	int err = g7_reg_read(0x200, 132);
+	if (err) {
+		return err;
+	}
+	const uint8_t *b = g7.rx + 6;
+	uint32_t mask = g7.active;
+	int x[G7_MAX], y[G7_MAX];
+	for (unsigned i = 0; i < G7_MAX; ++i) {
+		x[i] = g7.x[i];
+		y[i] = g7.y[i];
+	}
+	for (unsigned i = 0; i < G7_MAX; ++i) {
+		const uint8_t *p = b + 12u + 12u * i;
+		unsigned event = p[0] >> 4;
+		if (event == 1u || event == 2u) {
+			unsigned px = g7_le16(p + 2), py = g7_le16(p + 4);
+			if (px >= G7_PANEL_W || py >= G7_PANEL_H) {
+				continue;       /* garbage contact: ignore it, keep polling */
+			}
+			int lx, ly;
+			if (g7.scaled) {
+				lx = (int)(px * G7_LOG_W / G7_PANEL_W);
+				ly = (int)(py * G7_LOG_H / G7_PANEL_H);
+			} else {
+				lx = (int)px - (G7_PANEL_W - G7_LOG_W) / 2;
+				ly = (int)py - (G7_PANEL_H - G7_LOG_H) / 2;
+			}
+			x[i] = g7_clamp(lx - G7_HID_OX, -G7_HID_OX, G7_LOG_W - G7_HID_OX - 1);
+			y[i] = g7_clamp(ly - G7_HID_OY, -G7_HID_OY, G7_LOG_H - G7_HID_OY - 1);
+			if (!(mask & (1u << i))) {
+				g7.touches++;
+				g7.stage[7] = (g7.touches & 1u) ? G7_GREEN : G7_BLUE;
+			}
+			mask |= 1u << i;
+		} else if (event == 3u) {
+			mask &= ~(1u << i);
+		}
+	}
+	if (mask != g7.active || mask) {
+		++*frames;
+	}
+	g7_report(mask, x, y);
+	return 0;
+}
+
+static void
+g7_dump(const char *what)
+{
+	const uint8_t *b = g7.rx;
+	printf("G7 TOUCH: %s %02x%02x%02x%02x%02x%02x | %02x%02x%02x%02x %02x%02x%02x%02x "
+	    "%02x%02x%02x%02x | %02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x\n", what,
+	    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11],
+	    b[12], b[13], b[14], b[15], b[16], b[17], b[18], b[19], b[20], b[21],
+	    b[22], b[23], b[24], b[25], b[26], b[27], b[28], b[29]);
+}
+
+static const uint8_t g7_init_seq[8][6] = {
+	{0x6f, 0xe4, 0x01, 0x00, 0x00, 0x00},
+	{0x6f, 0xe5, 0x00, 0x00, 0x00, 0x00},
+	{0x6f, 0xf3, 0x03, 0x00, 0x00, 0x00},
+	{0x6f, 0xf3, 0x03, 0x00, 0x00, 0x00},
+	{0x6f, 0xf3, 0x03, 0x00, 0x00, 0x00},
+	{0x6c, 0x00, 0x01, 0x00, 0x00, 0x00},
+	{0x6c, 0x01, 0x01, 0x00, 0x00, 0x00},
+	{0x6c, 0x03, 0x85, 0x01, 0x00, 0x00},
+};
+
+static void
+g7_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 30, do_reset = 0, do_init = 1, div_arg = 0;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("g7touchdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("g7touch_reset", &do_reset, sizeof(do_reset));
+	(void)PE_parse_boot_argn("g7touch_init", &do_init, sizeof(do_init));
+	(void)PE_parse_boot_argn("g7touch_div", &div_arg, sizeof(div_arg));
+	printf("G7 TOUCH: SW49410 driver, starting in %u s (reset=%u init=%u)\n",
+	    delay_s, do_reset, do_init);
+	{
+		unsigned sc = 1;
+		(void)PE_parse_boot_argn("sweetfb_scale", &sc, sizeof(sc));
+		g7.scaled = sc != 0;
+	}
+	g7_sleep(delay_s * 1000u);
+	g7_bar_init();
+	g7_stage(1, G7_YELLOW);
+	g7.gcc = ml_io_map(G7_GCC_PA, 0x60000);
+	g7.north = ml_io_map(G7_NORTH_PA, 0x21000);
+	g7.east = ml_io_map(G7_EAST_PA, 0x59000);
+	g7.se = ml_io_map(G7_SE_PA, 0x4000);
+	if (!g7.gcc || !g7.north || !g7.east || !g7.se) {
+		printf("G7 TOUCH: MMIO mapping failed\n");
+		g7_stage(1, G7_RED);
+		goto out;
+	}
+	g7_stage(1, G7_GREEN);
+	printf("G7 TOUCH: gpio31 cfg=%#x io=%#x gpio32 cfg=%#x io=%#x gpio85 cfg=%#x\n",
+	    g7_rd(g7.north, G7_GPIO_CFG(31)), g7_rd(g7.north, G7_GPIO_IO(31)),
+	    g7_rd(g7.north, G7_GPIO_CFG(32)), g7_rd(g7.north, G7_GPIO_IO(32)),
+	    g7_rd(g7.east, G7_GPIO_CFG(85)));
+	unsigned div = g7_clocks();
+	if (!div) {
+		g7_stage(2, G7_RED);
+		goto out;
+	}
+	g7_stage(2, G7_GREEN);
+	if (div_arg) {
+		div = div_arg;
+	}
+	/*
+	 * On the G7 the SE5 firmware runs in GSI (GPI DMA) mode: IF_DISABLE has
+	 * FIFO_IF_DISABLE set and the M_CMD/FIFO registers are not ours. Then
+	 * (or with g7touch_bb=1) drive the four SPI pins as plain GPIOs.
+	 */
+	unsigned bb = (g7_rd(g7.se, SE_IF_DISABLE) & 1u) ? 1u : 0u;
+	(void)PE_parse_boot_argn("g7touch_bb", &bb, sizeof(bb));
+	g7_gpio(g7.north, G7_IRQ_GPIO, 0, 3, 0, false, false); /* input, pull-up */
+	if (bb) {
+		g7.bb = true;
+		/* gpio85 MISO in (pull-up), 86 MOSI, 87 CLK, 88 CS out; 4 mA. */
+		g7_gpio(g7.east, G7_BB_MISO, 0, 3, 1, false, false);
+		g7_gpio(g7.east, G7_BB_MOSI, 0, 0, 1, true, false);
+		g7_gpio(g7.east, G7_BB_CLK, 0, 0, 1, true, false);
+		g7_gpio(g7.east, G7_BB_CS, 0, 0, 1, true, true);
+		printf("G7 TOUCH: SE5 in GSI mode; bit-banged SPI on gpio85-88\n");
+		g7_stage(3, G7_GREEN);
+	} else {
+		/* SPI pins: qup5 (function 1), 6 mA, no pull. */
+		for (unsigned pin = 85; pin <= 88; ++pin) {
+			g7_gpio(g7.east, pin, 1, 0, 2, false, false);
+		}
+		if (!g7_se_init(div)) {
+			g7_stage(3, G7_RED);
+			goto out;
+		}
+		g7_stage(3, G7_GREEN);
+	}
+	/*
+	 * gpio32 (touch reset, active low) is left as a pulled-down input by
+	 * the bootloader, which may hold the touch side in reset. Release it
+	 * (drive high, no low pulse) unless g7touch_release=0.
+	 */
+	unsigned release = 1;
+	(void)PE_parse_boot_argn("g7touch_release", &release, sizeof(release));
+	if (release && !do_reset) {
+		unsigned was = g7_rd(g7.north, G7_GPIO_IO(G7_RST_GPIO)) & 1u;
+		g7_gpio(g7.north, G7_RST_GPIO, 0, 0, 0, true, true);
+		g7_sleep(300);
+		printf("G7 TOUCH: reset line released (was %u)\n", was);
+	}
+	if (do_reset) {
+		g7_gpio(g7.north, G7_RST_GPIO, 0, 0, 0, true, true);
+		g7_sleep(90);
+		g7_gpio_set(g7.north, G7_RST_GPIO, false);
+		g7_sleep(90);
+		g7_gpio_set(g7.north, G7_RST_GPIO, true);
+		g7_sleep(90);
+		printf("G7 TOUCH: reset pulsed\n");
+	}
+	int err = g7_reg_read(0x200, 132);
+	printf("G7 TOUCH: first read err=%d irq=%#x\n", err, g7.irq);
+	g7_stage(4, err ? G7_RED : G7_GREEN);
+	if (!err) {
+		g7_dump("pre-init");
+		unsigned kind = g7_rx_kind();
+		if (kind == 2) {
+			/* Only FFs (nothing drives MISO): try SPI mode 3 as well. */
+			if (g7.bb) {
+				g7.cpol = true;
+				g7_wr(g7.east, G7_GPIO_IO(G7_BB_CLK), 2u);
+			} else {
+				g7_wr(g7.se, SE_SPI_CPHA, 1);
+				g7_wr(g7.se, SE_SPI_CPOL, 1);
+			}
+			if (g7_reg_read(0x200, 132) == 0 && g7_rx_kind() == 0) {
+				printf("G7 TOUCH: chip answers in SPI mode 3\n");
+				kind = 0;
+			} else if (g7.bb) {
+				g7.cpol = false;
+				g7_wr(g7.east, G7_GPIO_IO(G7_BB_CLK), 0u);
+			} else {
+				g7_wr(g7.se, SE_SPI_CPHA, 0);
+				g7_wr(g7.se, SE_SPI_CPOL, 0);
+			}
+		}
+		printf("G7 TOUCH: chip data %s\n", kind == 0 ? "varies" :
+		    (kind == 1 ? "all 00" : "all ff"));
+		g7_stage(5, kind == 0 ? G7_GREEN : (kind == 1 ? G7_YELLOW : G7_RED));
+	}
+	{
+		/* tc_version (0x312) and product id (0x314): proof the chip answers */
+		uint32_t ver = 0;
+		if (g7_reg_read(0x312, 4) == 0) {
+			ver = (uint32_t)g7.rx[6] | ((uint32_t)g7.rx[7] << 8) |
+			    ((uint32_t)g7.rx[8] << 16) | ((uint32_t)g7.rx[9] << 24);
+		}
+		char pid[9];
+		bzero(pid, sizeof(pid));
+		if (g7_reg_read(0x314, 8) == 0) {
+			for (unsigned i = 0; i < 8; ++i) {
+				uint8_t c = g7.rx[6 + i];
+				pid[i] = (c >= 0x20 && c < 0x7f) ? (char)c : '.';
+			}
+		}
+		printf("G7 TOUCH: fw version %#x product '%s'\n", ver, pid);
+	}
+	if (do_init == 1) {
+		/*
+		 * LG touch_sw49410.c init (SPI writes: 0x40|addr hi, addr lo, LE32):
+		 * SPI_OSC_CTL=7, SPI_CLK_CTL=1 (touch clock on), tc_device_ctl=1,
+		 * tc_interrupt_ctl=1, tc_driving_ctl=0x181 (LCD mode U3, normal).
+		 */
+		static const uint32_t seq[5][2] = {
+			{0xFE1, 0x07}, {0xFE2, 0x01}, {0xC00, 0x01}, {0xC01, 0x01}, {0xC03, 0x181},
+		};
+		unsigned bad = 0;
+		for (unsigned i = 0; i < 5 && !g7.dead; ++i) {
+			uint32_t a = seq[i][0], v = seq[i][1];
+			g7.tx[0] = (uint8_t)(0x40u | ((a >> 8) & 0x0fu));
+			g7.tx[1] = (uint8_t)a;
+			g7.tx[2] = (uint8_t)v;
+			g7.tx[3] = (uint8_t)(v >> 8);
+			g7.tx[4] = (uint8_t)(v >> 16);
+			g7.tx[5] = (uint8_t)(v >> 24);
+			if (g7_spi(6)) {
+				bad++;
+			}
+			g7_sleep(i == 4 ? 30 : 10);
+		}
+		printf("G7 TOUCH: LG init sent (%u errors)\n", bad);
+		g7_stage(6, bad ? G7_RED : G7_GREEN);
+	} else if (do_init == 2) {
+		unsigned bad = 0;
+		for (unsigned i = 0; i < 8 && !g7.dead; ++i) {
+			bcopy(g7_init_seq[i], g7.tx, 6);
+			err = g7_spi(6);
+			if (err) {
+				bad++;
+				printf("G7 TOUCH: init %u err=%d irq=%#x\n", i, err, g7.irq);
+			}
+			g7_sleep(100);
+		}
+		printf("G7 TOUCH: init sequence sent\n");
+		g7_stage(6, bad ? G7_RED : G7_GREEN);
+	}
+	unsigned errors = 0, frames = 0, ticks = 0, shown = 0, alive_reports = 0;
+	while (!g7.dead) {
+		err = g7_poll(&frames);
+		g7.stage[6] = err ? G7_RED : G7_GREEN;
+		g7_bar_draw();
+		if (err) {
+			if ((errors++ % 200u) == 0) {
+				printf("G7 TOUCH: report err=%d irq=%#x\n", err, g7.irq);
+			}
+			if (errors == 20) {
+				g7_report(0, g7.x, g7.y);
+			}
+		} else {
+			errors = 0;
+			if (shown < 3 && (g7.rx[6 + 9] & 0x1fu)) {
+				g7_dump("touch");
+				shown++;
+			}
+		}
+		if (++ticks == 300) {
+			/* every ~5 s for the first while: proof of life */
+			printf("G7 TOUCH: alive, frames=%u active=%#x gpio31=%u\n", frames,
+			    g7.active, g7_rd(g7.north, G7_GPIO_IO(G7_IRQ_GPIO)) & 1u);
+			if (!err && frames == 0) {
+				g7_dump("idle");
+			}
+			/* stop after the first touch, or after ~1 minute (12 reports) */
+			ticks = (frames > 0 || ++alive_reports >= 12) ? 301 : 0;
+		}
+		g7_sleep(15);
+	}
+	g7_report(0, g7.x, g7.y);
+	g7_stage(7, G7_RED);
+out:
+	printf("G7 TOUCH: stopped\n");
+	/* Keep the strip visible after a failure so it can be photographed. */
+	for (unsigned i = 0; g7.bar && i < 4000u; ++i) {
+		g7_bar_draw();
+		g7_sleep(30);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_g7touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (g7.started) {
+		return;
+	}
+	g7.started = true;
+	(void)PE_parse_boot_argn("g7touch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("G7 TOUCH: disabled (g7touch=0)\n");
+		return;
+	}
+	if (kernel_thread_start(g7_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("G7 TOUCH: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
