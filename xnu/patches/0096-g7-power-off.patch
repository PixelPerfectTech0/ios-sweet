diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
index 2886202..f471030 100644
--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -16,6 +16,64 @@
 extern "C" int sweet_spmi_init(void);
 extern "C" int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
 extern "C" int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value);
+extern "C" int sweet_spmi_pon_shutdown(void);
+#include <IOKit/IOPlatformExpert.h>   /* PE_halt_restart */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/*
+ * G7 shut down and restart. Without a PE_halt_restart hook XNU printed "CPU halted" and spun, and the phone was reset
+ * from outside (watchdog) straight back into iOS. Halt: PMIC PS_HOLD action = shut down, then PSCI SYSTEM_OFF; if
+ * that returns, drop PS_HOLD. Restart: IMEM restart reason "normal" (not fastboot), then PSCI SYSTEM_RESET.
+ * Panics and other types keep the old behaviour (return -1: the panic text stays on screen).
+ */
+#define G7_IMEM_RESTART_PA   0x146aa000u   /* qcom,msm-imem; restart_reason at +0x65c */
+#define G7_PSHOLD_PA         0x0c264000u
+static vm_offset_t g7_imem, g7_pshold;
+
+static int32_t
+g7_psci(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+static int
+g7_halt_restart(unsigned int type)
+{
+	if (type == kPEHaltCPU) {
+		int pmic = sweet_spmi_pon_shutdown();
+		printf("SWEET POWER: power off (PMIC %d)\n", pmic);
+		if (g7_imem) {
+			*(volatile uint32_t *)(g7_imem + 0x65c) = 0;
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		int32_t r = g7_psci(0x84000008ULL);   /* SYSTEM_OFF */
+		printf("SWEET POWER: SYSTEM_OFF returned %d, dropping PS_HOLD\n", r);
+		if (g7_pshold) {
+			*(volatile uint32_t *)g7_pshold = 0;
+		}
+		for (;;) {
+			__asm__ volatile("wfe");
+		}
+	}
+	if (type == kPERestartCPU) {
+		printf("SWEET POWER: restart\n");
+		if (g7_imem) {
+			*(volatile uint32_t *)(g7_imem + 0x65c) = 0x77665501u;   /* normal reboot */
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		int32_t r = g7_psci(0x84000009ULL);   /* SYSTEM_RESET */
+		printf("SWEET POWER: SYSTEM_RESET returned %d\n", r);
+		return -1;
+	}
+	return -1;
+}
 
