-	}
-	IOLockLock(sp_lock);
 	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
 	if (apid == SP_NO_APID || apid >= 512 || sp_poisoned[apid] || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
-		IOLockUnlock(sp_lock);
 		return -2;
 	}
 	if (!chan[apid]) {
 		chan[apid] = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
 		if (!chan[apid]) {
-			IOLockUnlock(sp_lock);
 			return -3;
 		}
 	}
@@ -162,14 +158,52 @@ sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
 	for (unsigned i = 0; i < 1000; ++i) {
 		uint32_t status = sp_rd(c, 0x08u);
 		if (status & 1u) {
-			IOLockUnlock(sp_lock);
 			return (status & 0x0eu) ? -4 : 0;
 		}
 		delay(1);
 	}
 	sp_poisoned[apid] = true;
 	printf("SWEET BATTERY: SPMI write timeout sid=%u addr=%#x APID=%u disabled\n", sid, addr, apid);
-	IOLockUnlock(sp_lock);
 	return -5;
 }
+
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	if (!sp_ready || sid != 2 || addr != 0x1370u) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	int r = sp_owner_write(sid, addr, value);
+	IOLockUnlock(sp_lock);
+	return r;
+}
+
+/*
+ * G7 power off. The PM8998 (SID 0) PON block decides what happens when the SoC drops PS_HOLD; left as a reset, a halted
+ * phone came straight back up into iOS. Set PS_HOLD_RESET_CTL 0x085a to 4 (SHUTDOWN), with the PS_HOLD reset disabled
+ * around the change (PS_HOLD_RESET_CTL2 0x085b bit 7), as Linux qpnp-power-on does before PSCI SYSTEM_OFF.
+ * Halt time only: the other CPUs are stopped, so a lock left held is not waited for.
+ */
+int
+sweet_spmi_pon_shutdown(void)
+{
+	if (!sp_ready) {
+		return -1;
+	}
+	bool locked = IOLockTryLock(sp_lock);
+	int r = sp_owner_write(0, 0x085bu, 0x00);
+	if (r == 0) {
+		delay(1000);
+		r = sp_owner_write(0, 0x085au, 0x04);
+	}
+	if (r == 0) {
+		delay(1000);
+		r = sp_owner_write(0, 0x085bu, 0x80);
+	}
+	if (locked) {
+		IOLockUnlock(sp_lock);
+	}
+	return r;
+}
