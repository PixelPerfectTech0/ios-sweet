+
+/* Odd parity of a value's nibbles, as PM4 type-7 headers carry it. */
+static uint32_t
+g7g_odd(uint32_t v)
+{
+	v ^= v >> 16;
+	v ^= v >> 8;
+	v ^= v >> 4;
+	return (0x9669u >> (v & 0xfu)) & 1u;
+}
+
+static uint32_t
+g7g_pkt7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000u | (cnt & 0x3fffu) | (g7g_odd(cnt) << 15) | ((op & 0x7fu) << 16) | (g7g_odd(op) << 23);
+}
