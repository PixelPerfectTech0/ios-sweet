+/*
+ * Stage 4: ask the running GMU firmware to power the GX domain (the GPU
+ * core) at the SVS level, take CPU control of the SP/TP power switch, and
+ * then, only if the GMU reports GX powered and clocked, read two GPU core
+ * registers (a GX read with GX off would hang the bus).
+ */
+static void
+g7g_stage4(void)
+{
+	if (!g7g_db_map()) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage4: GMU running, but the RPMh command DB was not found");
+		return;
+	}
+	unsigned gl = 0, ml = 0;
+	int gi = g7g_arc_index("gfx.lvl", G7G_RPMH_LEVEL_SVS, &gl);
+	int mi = g7g_arc_index("mx.lvl", G7G_RPMH_LEVEL_SVS, &ml);
+	if (gi < 0 || mi < 0) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage4: GMU running, gfx/mx levels not in cmd-db (%d/%d)", gi, mi);
+		return;
+	}
+	g7g_gmu_wr(G7G_GMU_BOOT_SLUMBER_OPTION, 0);
+	g7g_gmu_wr(G7G_GMU_GX_VOTE_IDX, (uint32_t)gi);
+	g7g_gmu_wr(G7G_GMU_MX_VOTE_IDX, (uint32_t)mi);
+	g7g_gmu_wr(G7G_GMU_HOST2GMU_SET, 1u << G7G_OOB_BOOT_SLUMBER_SET);
+	uint32_t info = 0;
+	bool acked = g7g_gmu_wait(G7G_GMU_GMU2HOST_INFO, 1u << G7G_OOB_BOOT_SLUMBER_ACK,
+	    1u << G7G_OOB_BOOT_SLUMBER_ACK, 200000, &info);
+	g7g_gmu_wr(G7G_GMU_GMU2HOST_CLR, 1u << G7G_OOB_BOOT_SLUMBER_ACK);
+	printf("G7 GPU: stage4 boot vote gfx idx %d (level %u) mx idx %d (level %u): GMU %s (info %#x)\n",
+	    gi, gl, mi, ml, acked ? "acked" : "NO ACK", info);
+	if (!acked) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage4: GMU running, but it did not ack the GX boot request (%#x)", info);
+		return;
+	}
+	/* SP/TP power under CPU control: on. */
+	g7g_gmu_wr(G7G_GMU_GX_SPTPRAC_PWR_CTRL, 0x778000u);
+	uint32_t st = 0;
+	bool sptp = g7g_gmu_wait(G7G_GMU_SPTPRAC_STATUS, 0x38u, 0x28u, 20000, &st);
+	bool gx = !(st & ((1u << 6) | (1u << 7)));
+	printf("G7 GPU: stage4 sptprac %s, pwr/clk status %#x: GX %s\n", sptp ? "on" : "FAILED", st,
+	    gx ? "POWERED AND CLOCKED" : "still off");
+	if (!gx) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage4: GMU acked, but GX is still off (status %#x)", st);
+		return;
+	}
+	g7g.gpu = ml_io_map(G7G_GPU_PA, G7G_GPU_REG_SIZE);
+	if (!g7g.gpu) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage4: GX on, GPU register map failed");
+		return;
+	}
+	uint32_t rbbm = g7g_rd(g7g.gpu, G7G_RBBM_STATUS * 4u);
+	uint32_t c1 = g7g_rd(g7g.gpu, G7G_CP_ALWAYS_ON_LO * 4u);
+	delay(1000);
+	uint32_t c2 = g7g_rd(g7g.gpu, G7G_CP_ALWAYS_ON_LO * 4u);
+	printf("G7 GPU: stage4 GPU core rbbm_status %#x, cp always-on %#x -> %#x\n", rbbm, c1, c2);
+	snprintf(g7g.summary, sizeof(g7g.summary),
+	    "stage4: GX POWERED, GPU core %s (rbbm %#x, counter %#x -> %#x)",
+	    c1 != c2 ? "ANSWERS" : "silent", rbbm, c1, c2);
+	g7g.gx_ok = c1 != c2;
+}
+
+/*
+ * Stage 3: start the GMU (the GPU's Cortex-M3 power manager) with its
+ * firmware, the way a cold boot does: wake the RSC, copy the image into the
+ * GMU's instruction memory, set the boot registers, release the CM3 from
+ * reset and wait for the firmware's "init done" value. No HFI queues yet
+ * (they need GPU-visible memory through the SMMU, a later stage).
+ */
+static void
+g7g_stage3(void)
+{
+	if (!g7g_rpmh_init()) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage3: PDC map failed");
+		return;
+	}
+	g7g_gmu_wr(G7G_GMU_GENERAL_7, 1);        /* keep the TCMs powered */
+
+	/* Wake the RSC. */
+	uint32_t ack = 0, busy = 0;
+	g7g_gmu_wr(G7G_GMU_RSCC_CONTROL_REQ, 1u << 1);
+	bool woke = g7g_gmu_wait(G7G_GMU_RSCC_CONTROL_ACK, 1u << 1, 1u << 1, 10000, &ack);
+	for (int i = 0; i < 200; i++) {
+		busy = g7g_rscc_rd(G7G_RSCC_SEQ_BUSY_DRV0);
+		if (!busy) {
+			break;
+		}
+		delay(50);
+	}
+	g7g_gmu_wr(G7G_GMU_RSCC_CONTROL_REQ, 0);
+	printf("G7 GPU: stage3 RSC wake ack %#x seq_busy %#x -> %s\n", ack, busy, woke && !busy ? "awake" : "FAILED");
+	if (!woke || busy) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage3: GPU RSC did not wake (ack %#x busy %#x)", ack, busy);
+		return;
+	}
+
+	/* Firmware into the instruction memory, CM3 held in reset meanwhile. */
+	g7g_gmu_wr(G7G_GMU_CM3_SYSRESET, 1);
+	for (uint32_t i = 0; i < G7G_GMU_FW_BYTES / 4u; i++) {
+		g7g_gmu_wr(G7G_GMU_ITCM + i, i < G7G_GMU_FW_WORDS ? g7g_gmu_fw[i] : 0);
+	}
+	unsigned bad = 0;
+	for (uint32_t i = 0; i < G7G_GMU_FW_WORDS; i++) {
+		if (g7g_gmu_rd(G7G_GMU_ITCM + i) != g7g_gmu_fw[i]) {
+			bad++;
+		}
+	}
+	printf("G7 GPU: stage3 firmware %u words into ITCM, %u mismatches, first %#x %#x\n",
+	    G7G_GMU_FW_WORDS, bad, g7g_gmu_rd(G7G_GMU_ITCM), g7g_gmu_rd(G7G_GMU_ITCM + 1));
+	if (bad) {
+		snprintf(g7g.summary, sizeof(g7g.summary), "stage3: firmware copy failed (%u of %u words wrong)",
+		    bad, G7G_GMU_FW_WORDS);
+		return;
+	}
+
+	/* Boot registers (cold boot), as the GMU firmware expects them. */
+	g7g_gmu_wr(G7G_GMU_CM3_FW_INIT_RESULT, 0);
+	g7g_gmu_wr(G7G_GMU_CM3_BOOT_CONFIG, 0x02);
+	g7g_gmu_wr(G7G_GMU_HFI_QTBL_ADDR, 0);
+	g7g_gmu_wr(G7G_GMU_HFI_QTBL_INFO, 0);
+	g7g_gmu_wr(G7G_GMU_AHB_FENCE_RANGE_0, (1u << 31) | (0xau << 18) | 0xa0u);
+	g7g_gmu_wr(G7G_GMU_CM3_CFG, 0x4052);     /* start at main, not the NMI handler */
+	g7g_gmu_wr(G7G_GMU_HFI_SFR_ADDR, G7G_A630_GMU_CHIPID);
+	g7g_gmu_wr(G7G_GMU_PWR_COL_CP_MSG, 0);
+	g7g_gmu_wr(G7G_GMU_SYS_BUS_CONFIG, 1);
+	g7g_gmu_wr(G7G_GMU_ICACHE_CONFIG, 1);
+	g7g_gmu_wr(G7G_GMU_DCACHE_CONFIG, 1);
+	g7g_gmu_wr(G7G_GMU_PWR_COL_FRAME_CTRL, 0x9c40400u);   /* no idle power collapse */
+	g7g_gmu_wr(G7G_GMU_RPMH_CTRL, g7g_gmu_rd(G7G_GMU_RPMH_CTRL) |
+	    (1u << 0) | (1u << 4) | (1u << 8) | (1u << 9) | (1u << 10) | (1u << 11));
+
+	/* Release the CM3 and wait for "init done": 0xbabeface (older firmware) or 0x100. */
+	g7g_gmu_wr(G7G_GMU_CM3_SYSRESET, 1);
+	g7g_gmu_wr(G7G_GMU_PWR_COL_CP_RESP, 0);
+	g7g_gmu_wr(G7G_GMU_CM3_SYSRESET, 0);
+	uint32_t init = 0;
+	int ms;
+	for (ms = 0; ms < 500; ms++) {
+		init = g7g_gmu_rd(G7G_GMU_CM3_FW_INIT_RESULT);
+		if (init == 0xbabefaceu || (init & 0x1ffu) == 0x100u) {
+			break;
+		}
+		delay(1000);
+	}
+	bool up = init == 0xbabefaceu || (init & 0x1ffu) == 0x100u;
+	uint32_t g2h = g7g_gmu_rd(G7G_GMU_GMU2HOST_INFO);
+	printf("G7 GPU: stage3 CM3 init %#x after %d ms, hfi ver %#x status %#x, rpmh state %#x, "
+	    "gmu2host %#x ao irq %#x\n", init, ms, g7g_gmu_rd(G7G_GMU_HFI_VERSION_INFO),
+	    g7g_gmu_rd(G7G_GMU_HFI_CTRL_STATUS), g7g_gmu_rd(G7G_GMU_RPMH_POWER_STATE), g2h,
+	    g7g_gmu_rd(G7G_GMU_AO_HOST_IRQ_STATUS));
+	if (!up) {
+		g7g_gmu_wr(G7G_GMU_CM3_SYSRESET, 1);  /* park it again */
+	}
+	snprintf(g7g.summary, sizeof(g7g.summary), up ?
+	    "stage3: GMU FIRMWARE RUNNING (init %#x in %d ms, rpmh %#x)%s" :
+	    "stage3: GMU firmware did not start (init %#x after %d ms, rpmh %#x)%s",
+	    init, ms, g7g_gmu_rd(G7G_GMU_RPMH_POWER_STATE), (g2h & (1u << 23)) ? ", CM3 FAULT" : "");
+	if (up && g7g.level >= 4) {
+		g7g_stage4();
+	}
+}
