+/*
+ * GPU SMMU (ARM SMMU v2 at 0x05040000, CX domain, read only): is GPU memory
+ * access translated, bypassed or blocked? Decides how the next stages give
+ * the GPU memory (ring buffer, SQE firmware, HFI queues).
+ */
+#define G7G_SMMU_PA     0x05040000u
+#define G7G_SMMU_SIZE   0x00010000u
+
+static void
+g7g_smmu_report(void)
+{
+	vm_offset_t s = ml_io_map(G7G_SMMU_PA, G7G_SMMU_SIZE);
+	if (!s) {
+		snprintf(g7g.smmu, sizeof(g7g.smmu), "smmu: map failed");
+		return;
+	}
+	uint32_t cr0 = g7g_rd(s, 0x0), id0 = g7g_rd(s, 0x20), id1 = g7g_rd(s, 0x24);
+	unsigned nsmr = id0 & 0xffu, ncb = id1 & 0xffu;
+	printf("G7 GPU: smmu sCR0 %#x sIDR0 %#x sIDR1 %#x (%u stream matches, %u contexts)\n",
+	    cr0, id0, id1, nsmr, ncb);
+	unsigned used = 0;
+	for (unsigned i = 0; i < nsmr && i < 16; i++) {
+		uint32_t smr = g7g_rd(s, 0x800u + 4u * i), s2cr = g7g_rd(s, 0xc00u + 4u * i);
+		if (smr & (1u << 31)) {
+			used++;
+			printf("G7 GPU: smmu SMR%u %#x (id %#x mask %#x) S2CR %#x (type %u cb %u)\n", i, smr,
+			    smr & 0x7fffu, (smr >> 16) & 0x7fffu, s2cr, (s2cr >> 16) & 3u, s2cr & 0xffu);
+		}
+	}
+	snprintf(g7g.smmu, sizeof(g7g.smmu), "smmu: %s, unmatched streams %s, %u of %u matches in use",
+	    (cr0 & 1u) ? "CLIENTPD (all bypass)" : "enabled",
+	    (cr0 & (1u << 10)) ? "fault" : "bypass", used, nsmr);
+	/* Physical addresses reach memory only when nothing translates or blocks the GPU's streams. */
+	g7g.smmu_bypass = (cr0 & 1u) || (!(cr0 & (1u << 10)) && used == 0);
+}
