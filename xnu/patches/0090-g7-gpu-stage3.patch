+/*
+ * Cold-boot setup of the GPU's power sequencers: the RSC inside the GMU
+ * block and the PDC that turns its requests into RPMh votes for the GPU
+ * rails (0x30010 gfx, 0x30000 cx, 0x30080 mx on SDM845). Ends with the RSC
+ * asleep, as the GMU firmware expects before it is started.
+ */
+static bool
+g7g_rpmh_init(void)
+{
+	static const uint32_t rsc_seq[5] = { 0xa7a506a0u, 0xa1e6a6e7u, 0xa2e081e1u, 0xe9a982e2u, 0x0020e8a8u };
+	static const uint32_t pdc_seq[5] = { 0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u, 0x002081fcu };
+
+	g7g.pdc = ml_io_map(G7G_PDC_PA, G7G_PDC_SIZE);
+	g7g.pdcseq = ml_io_map(G7G_PDC_SEQ_PA, G7G_PDC_SIZE);
+	if (!g7g.pdc || !g7g.pdcseq) {
+		return false;
+	}
+	g7g_rscc_wr(G7G_RSCC_STATUS0_DRV0, 1u << 24);  /* no clock gating during setup */
+	g7g_rscc_wr(G7G_RSCC_PDC_SLAVE_ID, 1);
+	for (uint32_t i = 0; i < 6; i += 2) {
+		g7g_rscc_wr(G7G_RSCC_HIDDEN_TCS_DATA + i, i == 4 ? 0x80000000u : 0);
+		g7g_rscc_wr(G7G_RSCC_HIDDEN_TCS_ADDR + i, 0);
+	}
+	g7g_rscc_wr(G7G_RSCC_OVERRIDE_START, 0);
+	g7g_rscc_wr(G7G_RSCC_PDC_SEQ_START, 0x4520);
+	g7g_rscc_wr(G7G_RSCC_PDC_MATCH_LO, 0x4510);
+	g7g_rscc_wr(G7G_RSCC_PDC_MATCH_HI, 0x4514);
+	for (uint32_t i = 0; i < 5; i++) {
+		g7g_rscc_wr(G7G_RSCC_SEQ_MEM_0 + i, rsc_seq[i]);
+		g7g_wr(g7g.pdcseq, i * 4u, pdc_seq[i]);
+	}
+	/* TCS1: sleep votes; TCS3: wake votes (gfx, cx, mx). */
+	static const uint32_t tcs[2] = { G7G_PDC_TCS1, G7G_PDC_TCS3 };
+	static const uint32_t data[2][3] = { { 1, 0, 0 }, { 2, 3, 3 } };
+	for (int t = 0; t < 2; t++) {
+		g7g_wr(g7g.pdc, (tcs[t] + 1u) * 4u, 7);        /* ENABLE_BANK: 3 commands */
+		g7g_wr(g7g.pdc, (tcs[t] + 2u) * 4u, 0);        /* WAIT_FOR_CMPL_BANK */
+		g7g_wr(g7g.pdc, tcs[t] * 4u, 0);               /* CONTROL */
+		g7g_pdc_cmd(tcs[t], 0, 0x30010u, data[t][0]);
+		g7g_pdc_cmd(tcs[t], 1, 0x30000u, data[t][1]);
+		g7g_pdc_cmd(tcs[t], 2, 0x30080u, data[t][2]);
+	}
+	g7g_wr(g7g.pdc, G7G_PDC_SEQ_START * 4u, 0);
+	g7g_wr(g7g.pdc, G7G_PDC_ENABLE * 4u, 0x80000001u);
+
+	/* Put the RSC to sleep (power-off handshake), then release the request. */
+	g7g_gmu_wr(G7G_GMU_RSCC_CONTROL_REQ, 1);
+	uint32_t st = 0;
+	for (int i = 0; i < 200; i++) {
+		st = g7g_rscc_rd(G7G_RSCC_STATUS0_DRV0);
+		if (st & (1u << 16)) {
+			break;
+		}
+		delay(50);
+	}
+	g7g_gmu_wr(G7G_GMU_RSCC_CONTROL_REQ, 0);
+	printf("G7 GPU: stage3 RSC/PDC programmed, RSC sleep status %#x (%s)\n", st,
+	    (st & (1u << 16)) ? "asleep" : "did not sleep");
+	return true;
+}
