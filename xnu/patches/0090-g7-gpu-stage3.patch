+	g7g_gpu_wr64(G7G_UCHE_WRITE_THRU_BASE, 0x0001fffffffff000ull);
+	g7g_gpu_wr64(G7G_UCHE_GMEM_RANGE_MIN, gmem_min);
+	g7g_gpu_wr64(G7G_UCHE_GMEM_RANGE_MAX, gmem_min + G7G_A630_GMEM_BYTES - 1u);
+	g7g_gpu_wr(G7G_UCHE_FILTER_CNTL, 0x804);
+	g7g_gpu_wr(G7G_UCHE_CACHE_WAYS, 0x4);
+	g7g_gpu_wr(G7G_CP_ROQ_THRESHOLDS_2, 0x010000c0);
+	g7g_gpu_wr(G7G_CP_ROQ_THRESHOLDS_1, 0x8040362c);
+	g7g_gpu_wr(G7G_CP_MEM_POOL_SIZE, 128);
+	g7g_gpu_wr(G7G_CP_AHB_CNTL, 0x1);
+	g7g_gpu_wr(G7G_RBBM_PERFCTR_CNTL, 0x1);
+	g7g_gpu_wr(G7G_RBBM_HANG_INT_CNTL, (1u << 30) | 0x1fffff);
+	g7g_gpu_wr(G7G_UCHE_CLIENT_PF, (1u << 7) | 0x1);
+}
+
+/* Ask the GMU to keep the GPU on (OOB GPU_SET), as hw_init does; true when acked. */
+static bool
+g7g_gpu_hold(uint32_t *info)
+{
+	g7g_gmu_wr(G7G_GMU_HOST2GMU_SET, 1u << G7G_OOB_GPU_SET);
+	bool held = g7g_gmu_wait(G7G_GMU_GMU2HOST_INFO, 1u << G7G_OOB_GPU_ACK, 1u << G7G_OOB_GPU_ACK, 200000, info);
+	g7g_gmu_wr(G7G_GMU_GMU2HOST_CLR, 1u << G7G_OOB_GPU_ACK);
+	return held;
+}
+
+/*
+ * Stage 6 (g7gpu=6): with GX on and the GPU SMMU letting physical addresses
+ * through, run the command processor once: the A630 parts of the Linux
+ * hw_init register setup (bus, cache ranges, ring), SQE microcode in
+ * physically contiguous memory, CP_ME_INIT, then CP_MEM_WRITE of a marker
+ * into a scratch word. The marker read back by the CPU proves the GPU fetched
+ * the ring, ran the microcode and wrote memory. The CP stays in secure mode
+ * (no zap shader yet), which a CP_MEM_WRITE does not need.
+ */
+static void
+g7g_stage6(void)
+{
+	uint64_t sqe_pa = 0, ring_pa = 0, scratch_pa = 0;
+	uint32_t *sqe = IOMallocContiguous(0x10000, 0x1000, &sqe_pa);
+	uint32_t *ring = IOMallocContiguous(G7G_RING_BYTES, 0x1000, &ring_pa);
+	volatile uint32_t *scratch = IOMallocContiguous(0x1000, 0x1000, &scratch_pa);
+	if (!sqe || !ring || !scratch || !sqe_pa || !ring_pa || !scratch_pa) {
+		snprintf(g7g.cp, sizeof(g7g.cp), "stage6: contiguous memory allocation failed");
+		return;
+	}
+	for (uint32_t i = 0; i < G7G_SQE_FW_WORDS; i++) {
+		sqe[i] = g7g_sqe_fw[i];
+	}
+	memset(ring, 0, G7G_RING_BYTES);
+	scratch[0] = 0xdeadbeefu;
+	CleanPoC_DcacheRegion((vm_offset_t)sqe, 0x10000);
+	CleanPoC_DcacheRegion((vm_offset_t)scratch, 0x1000);
+	printf("G7 GPU: stage6 sqe pa %#llx ring pa %#llx scratch pa %#llx\n",
+	    (unsigned long long)sqe_pa, (unsigned long long)ring_pa, (unsigned long long)scratch_pa);
+
+	/* Keep the GPU on while it is set up. */
+	uint32_t info = 0;
+	if (!g7g_gpu_hold(&info)) {
+		snprintf(g7g.cp, sizeof(g7g.cp), "stage6: GMU did not ack GPU_SET (%#x)", info);
+		return;
+	}
+
+	g7g_hw_init(0x100000ull);
+
+	/* Ring and microcode, then start the SQE. */
+	g7g_gpu_wr64(G7G_CP_SQE_INSTR_BASE, sqe_pa);
+	g7g_gpu_wr64(G7G_CP_RB_BASE, ring_pa);
+	g7g_gpu_wr(G7G_CP_RB_CNTL, G7G_RB_CNTL_VALUE);
+	g7g_gpu_wr(G7G_CP_RB_WPTR, 0);
+	g7g_gpu_wr(G7G_CP_SQE_CNTL, 1);
+
+	/* CP_ME_INIT, then a marker write and a wait for idle. */
+	uint32_t w = 0;
+	ring[w++] = g7g_pkt7(G7G_PM4_ME_INIT, 8);
+	ring[w++] = 0x2f;
+	ring[w++] = 0x3;
+	ring[w++] = 0x20000000;
+	for (int i = 0; i < 5; i++) {
+		ring[w++] = 0;
+	}
+	ring[w++] = g7g_pkt7(G7G_PM4_MEM_WRITE, 3);
+	ring[w++] = (uint32_t)scratch_pa;
+	ring[w++] = (uint32_t)(scratch_pa >> 32);
+	ring[w++] = G7G_MARKER;
+	ring[w++] = g7g_pkt7(G7G_PM4_WAIT_FOR_IDLE, 0);
+	CleanPoC_DcacheRegion((vm_offset_t)ring, G7G_RING_BYTES);
+	g7g_gpu_wr(G7G_CP_RB_WPTR, w);
+
+	uint32_t rptr = 0, seen = 0;
+	int ms;
+	for (ms = 0; ms < 1000; ms++) {
+		delay(1000);
+		FlushPoC_DcacheRegion((vm_offset_t)scratch, 64);
+		seen = scratch[0];
+		rptr = g7g_gpu_rd(G7G_CP_RB_RPTR);
+		if (seen == G7G_MARKER && rptr == w) {
+			break;
+		}
+	}
+	uint32_t fault = g7g_gpu_rd(G7G_CP_HW_FAULT), cpint = g7g_gpu_rd(G7G_CP_INT_STATUS);
+	uint32_t rbbm = g7g_gpu_rd(G7G_RBBM_STATUS), int0 = g7g_gpu_rd(G7G_RBBM_INT_0_STATUS);
+	printf("G7 GPU: stage6 rptr %u/%u marker %#x rbbm %#x int0 %#x hwfault %#x cpint %#x after %d ms\n",
+	    rptr, w, seen, rbbm, int0, fault, cpint, ms);
+	snprintf(g7g.cp, sizeof(g7g.cp), seen == G7G_MARKER ?
+	    "stage6: COMMAND PROCESSOR RAN: marker %#x written by the GPU, rptr %u/%u, fault %#x" :
+	    "stage6: CP did not write the marker (%#x), rptr %u/%u, rbbm %#x, fault %#x, cpint %#x",
+	    seen, rptr, w, seen == G7G_MARKER ? fault : rbbm, seen == G7G_MARKER ? 0 : fault, cpint);
+	g7g.cp_ok = seen == G7G_MARKER;
+	g7g.ring = ring;
+	g7g.ring_w = w;
+	g7g.scratch = scratch;
+	g7g.scratch_pa = scratch_pa;
+}
+
+/* ---- Stage 7: zap shader through TrustZone ---- */
+
+struct g7g_smc_res {
+	uint64_t a0, a1, a2, a3;
+};
+
+/* One SMCCC call (x0..x6 in, x0..x3 out); the hypervisor forwards SiP calls to TrustZone. */
+static void
+g7g_smc(uint64_t fn, uint64_t arginfo, uint64_t a2, uint64_t a3, uint64_t a4, struct g7g_smc_res *r)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = arginfo;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	register uint64_t x4 __asm__("x4") = a4;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+	__asm__ volatile ("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    : "r"(x4), "r"(x5), "r"(x6)
+	    : "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	r->a0 = x0;
+	r->a1 = x1;
+	r->a2 = x2;
+	r->a3 = x3;
+}
+
+/*
+ * A Qualcomm SCM call: retried while TrustZone says "interrupted" (1, resume
+ * with x0 = 1) or "busy" (-12). Returns TrustZone's status (0 = ok); *result
+ * gets the first result word.
+ */
+static int64_t
+g7g_scm(uint32_t fn, uint32_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *result)
+{
+	struct g7g_smc_res r;
+	uint64_t x0 = fn;
+	for (int busy = 0; busy < 50; busy++) {
+		for (int i = 0; i < 1000; i++) {
+			g7g_smc(x0, arginfo, a, b, c, &r);
+			if (r.a0 != 1) {
+				break;
+			}
+			x0 = 1;
+		}
+		if ((int64_t)r.a0 != -12) {
+			break;
+		}
+		x0 = fn;
+		g7g_sleep(30);
+	}
+	if (result) {
+		*result = r.a1;
+	}
+	return (int64_t)r.a0;
+}
+
+/* Append a PM4 packet to the stage 6 ring and run it; true when rptr reaches the end. */
+static bool
+g7g_ring_run(const uint32_t *words, uint32_t n, uint32_t *rptr_out)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		g7g.ring[g7g.ring_w + i] = words[i];
+	}
+	CleanPoC_DcacheRegion((vm_offset_t)&g7g.ring[g7g.ring_w], n * 4u);
+	g7g.ring_w += n;
+	g7g_gpu_wr(G7G_CP_RB_WPTR, g7g.ring_w);
+	uint32_t rptr = 0;
+	for (int ms = 0; ms < 1000; ms++) {
+		delay(1000);
+		rptr = g7g_gpu_rd(G7G_CP_RB_RPTR);
+		if (rptr == g7g.ring_w) {
+			break;
+		}
+	}
+	if (rptr_out) {
+		*rptr_out = rptr;
+	}
+	return rptr == g7g.ring_w;
+}
+
+/*
+ * Load LG's zap shader through TrustZone's PAS service (Linux qcom_mdt_load +
+ * qcom_scm_pas_auth_and_reset order). 0 when TrustZone accepted it; a message
+ * in g7g.zap otherwise.
+ */
+static int
+g7g_zap_load(void)
+{
+	if (!g7g.zap_pa || g7g.zap_size < 0x100 || g7g.zap_size > 0x10000) {
+		snprintf(g7g.zap, sizeof(g7g.zap), "stage7: no zap image in the boot payload (G7Zap %#llx/%#llx)",
+		    (unsigned long long)g7g.zap_pa, (unsigned long long)g7g.zap_size);
+		return -1;
+	}
+	vm_offset_t img = ml_io_map((vm_offset_t)g7g.zap_pa, (vm_size_t)g7g.zap_size);
+	if (!img) {
+		snprintf(g7g.zap, sizeof(g7g.zap), "stage7: zap map failed");
+		return -1;
+	}
+	const uint8_t *b = (const uint8_t *)img;
+	uint32_t size = (uint32_t)g7g.zap_size;
+	/* ELF32: header, program headers, hash segment, one relocatable load segment. */
+	uint32_t phoff = 0, phnum = 0, phent = 0;
+	memcpy(&phoff, b + 0x1c, 4);
+	memcpy(&phent, b + 0x2a, 2);
+	memcpy(&phnum, b + 0x2c, 2);
+	if (memcmp(b, "\177ELF", 4) || b[4] != 1 || phent != 32 || phnum == 0 || phnum > 8 ||
+	    phoff + phnum * 32u > size) {
+		snprintf(g7g.zap, sizeof(g7g.zap), "stage7: zap image is not the expected ELF32");
+		return -1;
+	}
+	uint32_t hdr_len = phoff + phnum * 32u, hash_off = 0, hash_len = 0;
+	uint32_t load_off = 0, load_len = 0, load_mem = 0, load_pa = 0;
+	for (uint32_t i = 0; i < phnum; i++) {
+		uint32_t ph[8];
+		memcpy(ph, b + phoff + i * 32u, 32);    /* type off va pa filesz memsz flags align */
+		if (G7G_ELF_HASH_FLAGS(ph[6])) {
+			hash_off = ph[1];
+			hash_len = ph[4];
+		} else if (ph[0] == 1 && ph[5]) {
+			load_off = ph[1];
+			load_pa = ph[3];
+			load_len = ph[4];
+			load_mem = ph[5];
+		}
+	}
+	if (!hash_len || !load_mem || hash_off + hash_len > size || load_off + load_len > size ||
+	    load_mem > G7G_ZAP_REGION_SIZE) {
+		snprintf(g7g.zap, sizeof(g7g.zap), "stage7: zap layout unexpected (hash %#x+%#x load %#x+%#x/%#x)",
+		    hash_off, hash_len, load_off, load_len, load_mem);
+		return -1;
+	}
+
+	uint64_t supported = 0;
+	int64_t st = g7g_scm(G7G_SCM_PAS_IS_SUPPORTED, 1, G7G_GPU_PAS_ID, 0, 0, &supported);
+	printf("G7 GPU: stage7 PAS supported for GPU: status %lld result %llu\n", (long long)st,
+	    (unsigned long long)supported);
+
+	/* Metadata (ELF headers + hash) in contiguous memory TrustZone may lock while it checks it. */
+	uint64_t md_pa = 0;
+	uint8_t *md = IOMallocContiguous(0x4000, 0x1000, &md_pa);
+	if (!md || !md_pa) {
+		snprintf(g7g.zap, sizeof(g7g.zap), "stage7: metadata allocation failed");
+		return -1;
+	}
+	memcpy(md, b, hdr_len);
+	memcpy(md + hdr_len, b + hash_off, hash_len);
+	CleanPoC_DcacheRegion((vm_offset_t)md, 0x4000);
+	uint64_t res = 0;
+	int64_t s_init = g7g_scm(G7G_SCM_PAS_INIT_IMAGE, 0x82, G7G_GPU_PAS_ID, md_pa, 0, &res);
+	int64_t s_mem = -1, s_auth = -1;
+	if (s_init == 0) {
+		s_mem = g7g_scm(G7G_SCM_PAS_MEM_SETUP, 3, G7G_GPU_PAS_ID, G7G_ZAP_REGION_PA, load_mem, &res);
+	}
+	if (s_mem == 0) {
+		vm_offset_t region = ml_io_map(G7G_ZAP_REGION_PA, G7G_ZAP_REGION_SIZE);
+		if (region) {
+			/* One relocatable segment: it goes to the start of the region whatever its linked address. */
+			volatile uint8_t *dst = (volatile uint8_t *)region;
+			for (uint32_t i = 0; i < load_mem; i++) {
+				dst[i] = i < load_len ? b[load_off + i] : 0;
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			s_auth = g7g_scm(G7G_SCM_PAS_AUTH_RESET, 1, G7G_GPU_PAS_ID, 0, 0, &res);
+		}
+	}
+	printf("G7 GPU: stage7 zap %u bytes (segment %#x at %#x): init %lld mem_setup %lld auth_and_reset %lld "
+	    "(result %#llx)\n", size, load_mem, load_pa, (long long)s_init, (long long)s_mem, (long long)s_auth,
+	    (unsigned long long)res);
+	if (s_auth != 0) {
+		snprintf(g7g.zap, sizeof(g7g.zap), "stage7: TrustZone refused the zap (init %lld, mem %lld, auth %lld)",
+		    (long long)s_init, (long long)s_mem, (long long)s_auth);
+		return -1;
+	}
+
+	return 0;
+}
+
+static void
+g7g_stage7(void)
+{
+	if (g7g_zap_load()) {
+		return;
+	}
+	/* Leave secure mode, then prove the CP still runs with a second marker. */
+	uint32_t pk[6] = {
+		g7g_pkt7(G7G_PM4_SET_SECURE_MODE, 1), 0,
+		g7g_pkt7(G7G_PM4_MEM_WRITE, 3), (uint32_t)g7g.scratch_pa, (uint32_t)(g7g.scratch_pa >> 32), G7G_MARKER2,
+	};
+	uint32_t rptr = 0;
+	bool ran = g7g_ring_run(pk, 6, &rptr);
+	FlushPoC_DcacheRegion((vm_offset_t)g7g.scratch, 64);
+	uint32_t seen = g7g.scratch[0];
+	snprintf(g7g.zap, sizeof(g7g.zap), seen == G7G_MARKER2 ?
+	    "stage7: ZAP ACCEPTED, GPU OUT OF SECURE MODE, marker %#x, rptr %u/%u" :
+	    "stage7: zap accepted, but the CP did not run the next packets (marker %#x, rptr %u/%u)",
+	    seen, rptr, g7g.ring_w);
+	(void)ran;
+}
+
+/*
+ * ---- Stage 8 exports: what the full driver (iokit/Kernel/arm/g7adreno/G7Adreno.cpp) uses ----
+ * The GMU stays ours (stages 2-4 boot it and power GX); the driver gets MMIO
+ * access, the A630 register setup, the zap loader and the SQE microcode.
+ */
+int g7_adreno_bringup(char *msg, size_t n);
+uint32_t g7_gpu_rd(uint32_t dword);
+void g7_gpu_wr(uint32_t dword, uint32_t v);
+int g7_gpu_prepare(uint64_t gmem_min);
+int g7_gpu_zap(void);
+const uint32_t *g7_gpu_sqe(uint32_t *words);
+vm_offset_t g7_gpu_smmu(void);
+
+uint32_t
+g7_gpu_rd(uint32_t dword)
+{
+	return g7g.gpu ? g7g_gpu_rd(dword) : 0xffffffffu;
+}
+
+void
+g7_gpu_wr(uint32_t dword, uint32_t v)
+{
+	if (g7g.gpu) {
+		g7g_gpu_wr(dword, v);
+	}
+}
+
+/* Hold the GPU on (OOB GPU_SET) and program the A630 register setup; 0 on success. */
+int
+g7_gpu_prepare(uint64_t gmem_min)
+{
+	uint32_t info = 0;
+	if (!g7g.gpu || !g7g_gpu_hold(&info)) {
+		return -1;
+	}
+	g7g_hw_init(gmem_min);
+	return 0;
+}
+
+int
+g7_gpu_zap(void)
+{
+	return g7g_zap_load();
+}
+
+const uint32_t *
+g7_gpu_sqe(uint32_t *words)
+{
+	*words = G7G_SQE_FW_WORDS;
+	return g7g_sqe_fw;
+}
+
+vm_offset_t
+g7_gpu_smmu(void)
+{
+	return ml_io_map(G7G_SMMU_PA, G7G_SMMU_SIZE);
+}
+
+/* ---- RPMh command DB (read only) ---- */
+
+static uint16_t
+g7g_db16(uint32_t off)
+{
+	uint32_t v = g7g_rd(g7g.db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+g7g_db_in(uint32_t off, uint32_t len)
+{
+	return off <= g7g.db_size && len <= g7g.db_size - off;
+}
+
+/* Map the command DB: the AOP's locator first, the SDM845 DT address second. */
+static bool
+g7g_db_map(void)
+{
+	if (g7g.db) {
+		return true;
+	}
+	uint32_t pa = 0, size = 0;
+	vm_offset_t loc = ml_io_map(G7G_CMDDB_LOCATOR_PA & ~0xfffu, 0x1000);
+	if (loc) {
+		pa = g7g_rd(loc, G7G_CMDDB_LOCATOR_PA & 0xfffu);
+		size = g7g_rd(loc, (G7G_CMDDB_LOCATOR_PA & 0xfffu) + 4u);
+	}
+	printf("G7 GPU: stage4 cmd-db locator pa %#x size %#x\n", pa, size);
+	if (pa < 0x80000000u || (pa & 3u) || size < G7G_CMDDB_HEADER || size > 0x100000u) {
+		pa = G7G_CMDDB_DT_PA;
+		size = G7G_CMDDB_DT_SIZE;
+	}
+	g7g.db = ml_io_map(pa, size);
+	if (!g7g.db) {
+		return false;
+	}
+	g7g.db_size = size;
+	if (g7g_rd(g7g.db, 4) != G7G_CMDDB_MAGIC) {
+		printf("G7 GPU: stage4 no cmd-db at %#x (magic %#x)\n", pa, g7g_rd(g7g.db, 4));
+		g7g.db = 0;
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Index of the first ARC level >= want in the resource's level table
+ * (aux data: little-endian u16 levels); if none is that high, the highest
+ * non-zero level. -1 if the resource is not found.
+ */
+static int
+g7g_arc_index(const char *name, unsigned want, unsigned *level_out)
+{
+	uint32_t key[2] = { 0, 0 };
+	for (unsigned i = 0; i < 8 && name[i]; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8u * (i % 4));
+	}
+	for (unsigned s = 0; s < 8; s++) {
+		uint32_t h = 8u + 16u * s;
+		unsigned slave = g7g_db16(h);
+		if (!slave) {
+			break;
+		}
+		if (slave != G7G_CMDDB_SLAVE_ARC) {
+			continue;
+		}
+		uint32_t entries = G7G_CMDDB_HEADER + g7g_db16(h + 2);
+		uint32_t aux = G7G_CMDDB_HEADER + g7g_db16(h + 4);
+		unsigned count = g7g_db16(h + 6);
+		if ((entries & 3u) || !g7g_db_in(entries, count * G7G_CMDDB_ENTRY)) {
+			return -1;
+		}
+		for (unsigned j = 0; j < count; j++) {
+			uint32_t e = entries + G7G_CMDDB_ENTRY * j;
+			if (g7g_rd(g7g.db, e) != key[0] || g7g_rd(g7g.db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t len = g7g_db16(e + 20), off = aux + g7g_db16(e + 22);
+			if (!g7g_db_in(off, len) || len < 2) {
+				return -1;
+			}
+			int best = -1, top = -1;
+			unsigned n = len / 2u, lv = 0;
+			char list[96];
+			int at = 0;
+			for (unsigned k = 0; k < n && k < 16; k++) {
+				unsigned v = g7g_db16(off + 2u * k);
+				at += snprintf(list + at, sizeof(list) - (size_t)at, "%s%u", k ? "," : "", v);
+				if (at >= (int)sizeof(list)) {
+					at = (int)sizeof(list) - 1;
+				}
+				if (best < 0 && v >= want) {
+					best = (int)k;
+					lv = v;
+				}
+				if (v) {
+					top = (int)k;
+				}
+			}
+			printf("G7 GPU: stage4 %s levels [%s]\n", name, list);
+			if (best < 0 && top >= 0) {
+				best = top;
+				lv = g7g_db16(off + 2u * (unsigned)top);
+			}
+			if (level_out) {
+				*level_out = lv;
+			}
+			return best;
+		}
+	}
+	return -1;
+}
