+/* One PDC TCS command: message id, RPMh address, data (4 dwords per command). */
+static void
+g7g_pdc_cmd(uint32_t tcs, int k, uint32_t addr, uint32_t data)
+{
+	g7g_wr(g7g.pdc, (tcs + 3u + 4u * (uint32_t)k) * 4u, 0x10108u);
+	g7g_wr(g7g.pdc, (tcs + 4u + 4u * (uint32_t)k) * 4u, addr);
+	g7g_wr(g7g.pdc, (tcs + 5u + 4u * (uint32_t)k) * 4u, data);
+}
