+static bool
+g7g_gmu_wait(uint32_t dword, uint32_t mask, uint32_t want, unsigned max_us, uint32_t *last)
+{
+	uint32_t v = 0;
+	for (unsigned us = 0; us <= max_us; us += 50) {
+		v = g7g_gmu_rd(dword);
+		if ((v & mask) == want) {
